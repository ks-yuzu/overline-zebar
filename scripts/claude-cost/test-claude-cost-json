#!/usr/bin/env python3

import contextlib
import datetime as dt
import importlib.machinery
import importlib.util
import io
import json
import os
import sys
import tempfile
import unittest
from pathlib import Path
from unittest import mock


HERE = Path(__file__).resolve().parent
SCRIPT = HERE / "claude-cost-json"
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("claude_cost_json", str(SCRIPT))
spec = importlib.util.spec_from_loader(loader.name, loader)
cost = importlib.util.module_from_spec(spec)
loader.exec_module(cost)


def vector(samples):
    return json.dumps({
        "status": "success",
        "data": {"resultType": "vector", "result": [
            {"metric": metric, "value": [1789000000.0, str(value)]}
            for metric, value in samples
        ]},
    })


WEEK_SECONDS = 7 * 86400
SESSION_SECONDS = 5 * 3600


class WindowTests(unittest.TestCase):
    def bounds(self, payload, now="2026-09-13T12:00:00+09:00",
               key="current_week", length=WEEK_SECONDS):
        with tempfile.TemporaryDirectory() as root:
            path = Path(root) / "usage.json"
            if payload is not None:
                path.write_text(payload)
            return cost.window_bounds(cost.read_usage_cache(path), key, length,
                                      dt.datetime.fromisoformat(now))

    def test_the_window_starts_seven_days_before_the_reported_reset(self):
        start, reset, source = self.bounds(json.dumps(
            {"current_week": {"resets_at": "2026-09-14T09:00:00+09:00"}}))
        self.assertEqual(start.isoformat(), "2026-09-07T09:00:00+09:00")
        self.assertEqual(reset.isoformat(), "2026-09-14T09:00:00+09:00")
        self.assertEqual(source, "usage_cache")

    def test_a_reset_that_has_passed_is_carried_to_the_current_window(self):
        # usage cache が reset をまたいで止まると、報告された reset は前の週の
        # ものになる。そのまま使うと窓が 7 日より長くなる。
        start, reset, source = self.bounds(
            json.dumps({"current_week": {"resets_at": "2026-09-07T09:00:00+09:00"}}),
            now="2026-09-13T12:00:00+09:00")
        self.assertEqual(reset.isoformat(), "2026-09-14T09:00:00+09:00")
        self.assertEqual(start.isoformat(), "2026-09-07T09:00:00+09:00")
        self.assertEqual(source, "usage_cache_rolled")

    def test_a_reset_stale_by_weeks_is_carried_by_whole_weeks(self):
        start, reset, source = self.bounds(
            json.dumps({"current_week": {"resets_at": "2026-08-17T09:00:00+09:00"}}),
            now="2026-09-13T12:00:00+09:00")
        self.assertEqual(reset.isoformat(), "2026-09-14T09:00:00+09:00")
        self.assertEqual(source, "usage_cache_rolled")

    def test_the_window_is_never_longer_than_its_length(self):
        now = dt.datetime.fromisoformat("2026-09-13T12:00:00+09:00")
        for days in range(0, 40):
            reset = now - dt.timedelta(days=days, hours=3)
            start, rolled, _ = self.bounds(
                json.dumps({"current_week": {"resets_at": reset.isoformat()}}))
            self.assertLessEqual((now - start).total_seconds(), WEEK_SECONDS, days)
            self.assertGreater(rolled, now, days)

    def test_the_session_window_is_five_hours_from_its_own_reset(self):
        start, reset, source = self.bounds(
            json.dumps({"current_session": {"resets_at": "2026-09-13T14:10:00+09:00"},
                        "current_week": {"resets_at": "2026-09-14T09:00:00+09:00"}}),
            key="current_session", length=SESSION_SECONDS)
        self.assertEqual(start.isoformat(), "2026-09-13T09:10:00+09:00")
        self.assertEqual(reset.isoformat(), "2026-09-13T14:10:00+09:00")
        self.assertEqual(source, "usage_cache")

    def test_a_passed_session_reset_is_carried_in_five_hour_steps(self):
        start, reset, source = self.bounds(
            json.dumps({"current_session": {"resets_at": "2026-09-13T04:10:00+09:00"}}),
            key="current_session", length=SESSION_SECONDS)
        self.assertEqual(reset.isoformat(), "2026-09-13T14:10:00+09:00")
        self.assertEqual(source, "usage_cache_rolled")

    def test_the_helper_asks_for_both_windows(self):
        self.assertEqual([name for name, _, _ in cost.WINDOWS], ["session", "week"])
        lengths = {name: length for name, length, _ in cost.WINDOWS}
        self.assertEqual(lengths, {"session": SESSION_SECONDS, "week": WEEK_SECONDS})

    def test_a_reset_without_an_offset_is_unreadable(self):
        # parse はできるが aware な now と比べた瞬間に TypeError になり、
        # cache を読めなかった時の退避経路を通らずに実行ごと落ちる。
        start, reset, source = self.bounds(
            json.dumps({"current_week": {"resets_at": "2026-09-14T09:00:00"}}))
        self.assertEqual(source, "fallback_length")
        self.assertIsNone(reset)

    def test_an_unreadable_usage_cache_falls_back_to_a_plain_week(self):
        for payload in (None, "{", "{}", json.dumps({"current_week": {}}),
                        json.dumps({"current_week": {"resets_at": "tomorrow"}})):
            start, reset, source = self.bounds(payload)
            self.assertEqual(source, "fallback_length", payload)
            self.assertIsNone(reset)
            self.assertEqual(start.isoformat(), "2026-09-06T12:00:00+09:00")


class ParseTests(unittest.TestCase):
    def test_a_vector_is_read_into_label_sets_and_values(self):
        parsed = cost.parse_vector(vector([({"session_id": "s1"}, 1.5)]))
        self.assertEqual(parsed, [({"session_id": "s1"}, 1.5)])

    def test_a_response_that_cannot_be_read_is_not_an_empty_result(self):
        # 引けなかったことと 1 件も無かったことを混ぜると、Grafana が答えなく
        # なった時に空の画面を正しい答えとして公開してしまう。
        for payload in ("", "{", "[]", json.dumps({"status": "error", "error": "boom"}),
                        json.dumps({"status": "success", "data": {"resultType": "matrix",
                                                                  "result": []}}),
                        json.dumps({"status": "success", "data": {"resultType": "vector",
                                                                  "result": [{"metric": {}}]}}),
                        json.dumps({"status": "success", "data": {"resultType": "vector",
                                                                  "result": [{"metric": {},
                                                                              "value": [1, "x"]}]}})):
            with self.assertRaises(cost.CostError, msg=payload):
                cost.parse_vector(payload)

    def test_an_empty_vector_is_an_answer(self):
        self.assertEqual(cost.parse_vector(vector([])), [])


class FailureDetailTests(unittest.TestCase):
    """gcx は失敗の詳細を stdout へ書き、stderr は空のまま終了する (実測)。"""

    ENVELOPE = json.dumps({
        "type": "gcx.error", "schema_version": "1",
        "error": {"summary": "Invalid PromQL query", "exitCode": 1,
                  "details": "bad_data: invalid parameter \"query\":\n1:9: parse error",
                  "suggestions": ["Run 'gcx metrics query --help'"]},
    })

    def test_the_detail_comes_from_the_error_envelope_on_stdout(self):
        line = cost.failure_detail(self.ENVELOPE, "", 1)
        self.assertIn("Invalid PromQL query", line)
        self.assertIn("1:9: parse error", line)
        self.assertNotIn("\n", line)

    def test_stderr_is_used_when_there_is_no_envelope(self):
        self.assertEqual(cost.failure_detail("", "boom\n", 3), "boom")

    def test_an_unparsable_stdout_is_reported_as_it_stands(self):
        self.assertEqual(cost.failure_detail("panic: nil map\n", "", 2), "panic: nil map")

    def test_a_silent_failure_still_names_the_exit_status(self):
        self.assertEqual(cost.failure_detail("", "", 137), "exit status 137")

    def test_a_query_failure_carries_the_detail(self):
        with tempfile.TemporaryDirectory() as root:
            fake = Path(root) / "gcx"
            fake.write_text("#!/bin/sh\ncat <<'JSON'\n" + self.ENVELOPE + "\nJSON\nexit 1\n")
            fake.chmod(0o755)
            with self.assertRaises(cost.CostError) as raised:
                cost.run_query({"gcx": str(fake), "context": "", "datasource": "d",
                                "timeout": 10}, "up")
            self.assertIn("Invalid PromQL query", str(raised.exception))


class RowTests(unittest.TestCase):
    def info(self):
        return {"s1": {"session_name": "#1 一番", "project": "p"},
                "s2": {"session_name": "#2 二番", "project": "p"}}

    def test_rows_are_sorted_by_cost_and_capped(self):
        rows, _, _, _, _ = cost.build_rows({"s1": 1.0, "s2": 5.0}, self.info(), 1)
        self.assertEqual([row["session_name"] for row in rows], ["#2 二番"])

    def test_a_session_known_only_by_its_project_still_gets_a_row(self):
        # 題がまだ付いていない session も info は持ち、project が入る。
        # project の分かる行は「不明」より情報がある。
        rows, unresolved, count, _, _ = cost.build_rows(
            {"s1": 1.0}, {"s1": {"project": "overline-zebar"}}, 10)
        self.assertEqual([row["project"] for row in rows], ["overline-zebar"])
        self.assertEqual((unresolved, count), (0.0, 0))

    def test_a_session_without_a_name_becomes_unresolved(self):
        # 落とすと合計が合わなくなる。別マシンから送られた session が該当する。
        rows, unresolved, count, _, _ = cost.build_rows(
            {"s1": 1.0, "elsewhere": 9.0}, self.info(), 10)
        self.assertEqual([row["session_id"] for row in rows], ["s1"])
        self.assertEqual((unresolved, count), (9.0, 1))

    def test_sessions_past_the_cap_are_counted_not_discarded(self):
        # 行だけを切り落とすと、total に含まれる額がどこにも現れない。
        rows, _, _, truncated, truncated_count = cost.build_rows(
            {"s1": 1.0, "s2": 5.0}, self.info(), 1)
        self.assertEqual([row["session_id"] for row in rows], ["s2"])
        self.assertEqual((truncated, truncated_count), (1.0, 1))

    def test_the_parts_add_up_to_the_total(self):
        costs = {"s1": 1.0, "s2": 5.0, "elsewhere": 9.0, "dust": 0.001}
        rows, unresolved, _, truncated, _ = cost.build_rows(costs, self.info(), 1)
        shown = sum(row["cost"] for row in rows)
        total = sum(value for value in costs.values() if value >= cost.COST_FLOOR)
        self.assertAlmostEqual(shown + unresolved + truncated, total)

    def test_amounts_that_would_render_as_zero_are_dropped(self):
        rows, unresolved, count, truncated, _ = cost.build_rows(
            {"s1": 0.001, "gone": 0.001}, self.info(), 10)
        self.assertEqual(rows, [])
        self.assertEqual((unresolved, count, truncated), (0.0, 0, 0.0))

    def test_the_order_does_not_depend_on_dictionary_order(self):
        rows, _, _, _, _ = cost.build_rows({"s2": 5.0, "s1": 5.0}, self.info(), 10)
        self.assertEqual([row["session_id"] for row in rows], ["s1", "s2"])


class SessionInfoTests(unittest.TestCase):
    def info_from(self, samples):
        with mock.patch.object(cost, "run_query", return_value=samples):
            return cost.session_info({})

    def test_labels_are_copied_from_the_series(self):
        found = self.info_from([({"session_id": "s1", "session_name": "#1 一番",
                                 "project": "p", "instance": "host"}, 1.0)])
        self.assertEqual(found["s1"], {"session_name": "#1 一番", "project": "p"})

    def test_two_series_for_one_session_yield_no_name(self):
        # どちらが正かを決める情報が無い。名前を付けずに「不明」へ送る方が、
        # 別の session の名前を出すより軽い。
        found = self.info_from([({"session_id": "s1", "session_name": "古い"}, 1.0),
                                ({"session_id": "s1", "session_name": "新しい"}, 1.0)])
        self.assertIsNone(found["s1"])
        rows, unresolved, count, _, _ = cost.build_rows({"s1": 3.0}, found, 10)
        self.assertEqual((rows, unresolved, count), ([], 3.0, 1))


class WindowCostTests(unittest.TestCase):
    def test_the_first_sample_is_added_back_per_session(self):
        queries = []

        def fake(config, expression, at=None):
            queries.append((expression, at))
            if expression.startswith("sum by (session_id) (increase"):
                return [({"session_id": "s1"}, 10.0), ({"session_id": "s2"}, 4.0)]
            return [({"session_id": "s1"}, 2.0)]

        with mock.patch.object(cost, "run_query", side_effect=fake):
            totals = cost.window_cost({}, 1000.0, 4600.0)
        self.assertEqual(totals, {"s1": 12.0, "s2": 4.0})
        self.assertIn("[3600s]", queries[0][0])
        # 窓の起点に在った系列を外すのは `unless` の側で、加算は helper が行う。
        # PromQL の `+` は内部結合で、`unless` が除いた系列を加算ごと落とす。
        self.assertIn("unless", queries[1][0])
        self.assertNotIn("+", queries[1][0])
        # 3 本が別々の瞬間を見ないよう、評価時刻を捕まえた now へ固定する。
        self.assertEqual([at for _, at in queries], [4600.0, 4600.0])

    def test_the_addback_is_anchored_at_the_window_start(self):
        with mock.patch.object(cost, "run_query", return_value=[]) as query:
            cost.window_cost({}, 1788739200.0, 1789304700.0)
        self.assertIn("@ 1788739200", query.call_args_list[1].args[1])
        self.assertEqual(query.call_args_list[1].args[2], 1789304700.0)

    def test_the_evaluation_time_reaches_the_command_line(self):
        captured = {}

        class FakeCompleted:
            returncode = 0
            stdout = vector([]).encode()
            stderr = b""

        def fake_run(command, **kwargs):
            captured["command"] = command
            return FakeCompleted()

        with mock.patch.object(cost.subprocess, "run", side_effect=fake_run):
            cost.run_query({"gcx": "gcx", "context": "", "datasource": "d", "timeout": 1},
                           "up", 1789304700.0)
        self.assertIn("--time", captured["command"])
        self.assertEqual(captured["command"][captured["command"].index("--time") + 1],
                         "1789304700")


class OutputTests(unittest.TestCase):
    def output(self, costs, info, top=20, usage_cache="absent.json", seen=None):
        def fake(config, expression, at=None):
            if seen is not None:
                seen.append(at)
            if expression.startswith(cost.INFO_METRIC):
                return [({"session_id": key, **labels}, 1.0)
                        for key, labels in info.items()]
            if "increase" in expression:
                return [({"session_id": key}, value) for key, value in costs.items()]
            return []

        with mock.patch.object(cost, "run_query", side_effect=fake):
            return cost.build_output(
                {"top": top, "usage_cache": usage_cache},
                dt.datetime.fromisoformat("2026-09-13T12:00:00+09:00"))["windows"]["week"]

    def parts(self, built):
        return (sum(row["cost"] for row in built["sessions"])
                + built["unresolved"]["cost"] + built["truncated"]["cost"])

    def test_the_reported_parts_add_up_to_the_reported_total(self):
        # 行ごとの丸めと生の合計の丸めがずれると、内訳と合計を突き合わせられない。
        built = self.output({"s1": 0.0050004, "s2": 0.0050004, "elsewhere": 0.0050004},
                            {"s1": {"session_name": "一番"}, "s2": {"session_name": "二番"}})
        self.assertEqual(built["total"], round(self.parts(built), 6))

    def test_the_agreement_is_at_six_decimals_not_in_binary(self):
        # 6 桁の値を足した結果がその桁で表せるとは限らない。実データで
        # 行の合計 20.099999999999998 と total 20.1 が食い違った。
        built = self.output({"s1": 0.1, "s2": 0.2},
                            {"s1": {"session_name": "一番"}, "s2": {"session_name": "二番"}})
        self.assertNotEqual(built["total"], self.parts(built))
        self.assertEqual(built["total"], round(self.parts(built), 6))

    def test_every_query_is_evaluated_at_the_same_instant(self):
        # 題が書き換わる瞬間をまたぐと、別の瞬間の label を凍らせたコストへ付ける。
        seen = []
        self.output({"s1": 1.0}, {"s1": {"session_name": "一番"}}, seen=seen)
        # 窓 2 つ × コスト 2 本 + 名前 1 本。名前は窓ごとに引き直さない。
        self.assertEqual(len(seen), 5)
        self.assertEqual(len(set(seen)), 1)
        self.assertIsNotNone(seen[0])

    def test_both_windows_are_reported(self):
        def fake(config, expression, at=None):
            if expression.startswith(cost.INFO_METRIC):
                return [({"session_id": "s1", "session_name": "一番"}, 1.0)]
            if "increase" in expression:
                return [({"session_id": "s1"}, 1.0)]
            return []

        with mock.patch.object(cost, "run_query", side_effect=fake):
            built = cost.build_output(
                {"top": 20, "usage_cache": "absent.json"},
                dt.datetime.fromisoformat("2026-09-13T12:00:00+09:00"))
        self.assertEqual(sorted(built["windows"]), ["session", "week"])
        session, week = built["windows"]["session"], built["windows"]["week"]
        self.assertEqual((dt.datetime.fromisoformat(session["starts_at"])
                          - dt.datetime.fromisoformat(built["generated_at"])).total_seconds(),
                         -SESSION_SECONDS)
        self.assertEqual((dt.datetime.fromisoformat(week["starts_at"])
                          - dt.datetime.fromisoformat(built["generated_at"])).total_seconds(),
                         -WEEK_SECONDS)

    def test_the_identity_holds_when_rows_are_truncated(self):
        built = self.output({f"s{n}": 1.0 / 3 for n in range(9)},
                            {f"s{n}": {"session_name": str(n)} for n in range(9)}, top=2)
        self.assertEqual(built["total"], round(self.parts(built), 6))
        self.assertEqual(built["truncated"]["sessions"], 7)


class CacheTests(unittest.TestCase):
    def helper(self, root, argv, gcx="true"):
        environment = {
            "CLAUDE_COST_CACHE_DIR": str(root),
            "CLAUDE_COST_GCX_BIN": gcx,
            "CLAUDE_COST_USAGE_CACHE": str(Path(root) / "absent.json"),
        }
        with mock.patch.dict(os.environ, environment), \
                contextlib.redirect_stderr(io.StringIO()) as complaint:
            stream = io.BytesIO()
            with mock.patch.object(sys, "stdout", mock.Mock(buffer=stream)):
                code = cost.main(argv)
        return code, stream.getvalue().decode(), complaint.getvalue()

    def test_a_failed_query_keeps_the_previous_reading(self):
        # `generated_at` が動かないことで、読む側から停止が見える。
        with tempfile.TemporaryDirectory() as root:
            previous = '{"generated_at":"2026-09-01T00:00:00+09:00","total":1}'
            (Path(root) / "cost.json").write_text(previous)
            code, printed, complaint = self.helper(root, ["--force"], gcx="false")
            self.assertEqual(code, 0)
            self.assertEqual(printed, previous)
            self.assertEqual((Path(root) / "cost.json").read_text(), previous)
            self.assertIn("claude cost:", complaint)

    def test_a_failed_query_without_a_previous_reading_says_so(self):
        with tempfile.TemporaryDirectory() as root:
            code, printed, _ = self.helper(root, ["--force"], gcx="false")
            self.assertEqual(code, 69)
            self.assertEqual(printed, "")

    def test_cached_only_never_runs_a_query(self):
        with tempfile.TemporaryDirectory() as root:
            (Path(root) / "cost.json").write_text('{"total":1}')
            code, printed, _ = self.helper(
                root, ["--cached-only"], gcx="/nonexistent/gcx")
            self.assertEqual(code, 0)
            self.assertEqual(printed, '{"total":1}')

    def test_cached_only_reports_a_missing_cache(self):
        with tempfile.TemporaryDirectory() as root:
            code, printed, complaint = self.helper(root, ["--cached-only"])
            self.assertEqual(code, 66)
            self.assertEqual(printed, "")
            self.assertIn("not available yet", complaint)


