def vector(samples):
    return json.dumps({
        "status": "success",
        "data": {"resultType": "vector", "result": [
            {"metric": metric, "value": [1789000000.0, str(value)]}
            for metric, value in samples
        ]},
    })


WEEK_SECONDS = 7 * 86400
SESSION_SECONDS = 5 * 3600


class WindowTests(unittest.TestCase):
    def bounds(self, payload, now="2026-09-13T12:00:00+09:00",
               key="current_week", length=WEEK_SECONDS):
        with tempfile.TemporaryDirectory() as root:
            path = Path(root) / "usage.json"
            if payload is not None:
                path.write_text(payload)
            return cost.window_bounds(cost.read_usage_cache(path), key, length,
                                      dt.datetime.fromisoformat(now))

    def test_the_window_starts_seven_days_before_the_reported_reset(self):
        start, reset, source = self.bounds(json.dumps(
            {"current_week": {"resets_at": "2026-09-14T09:00:00+09:00"}}))
        self.assertEqual(start.isoformat(), "2026-09-07T09:00:00+09:00")
        self.assertEqual(reset.isoformat(), "2026-09-14T09:00:00+09:00")
        self.assertEqual(source, "usage_cache")

    def test_a_reset_that_has_passed_is_carried_to_the_current_window(self):
        # usage cache が reset をまたいで止まると、報告された reset は前の週の
        # ものになる。そのまま使うと窓が 7 日より長くなる。
        start, reset, source = self.bounds(
            json.dumps({"current_week": {"resets_at": "2026-09-07T09:00:00+09:00"}}),
            now="2026-09-13T12:00:00+09:00")
        self.assertEqual(reset.isoformat(), "2026-09-14T09:00:00+09:00")
        self.assertEqual(start.isoformat(), "2026-09-07T09:00:00+09:00")
        self.assertEqual(source, "usage_cache_rolled")

    def test_a_reset_stale_by_weeks_is_carried_by_whole_weeks(self):
        start, reset, source = self.bounds(
            json.dumps({"current_week": {"resets_at": "2026-08-17T09:00:00+09:00"}}),
            now="2026-09-13T12:00:00+09:00")
        self.assertEqual(reset.isoformat(), "2026-09-14T09:00:00+09:00")
        self.assertEqual(source, "usage_cache_rolled")

    def test_the_window_is_never_longer_than_its_length(self):
        now = dt.datetime.fromisoformat("2026-09-13T12:00:00+09:00")
        for days in range(0, 40):
            reset = now - dt.timedelta(days=days, hours=3)
            start, rolled, _ = self.bounds(
                json.dumps({"current_week": {"resets_at": reset.isoformat()}}))
            self.assertLessEqual((now - start).total_seconds(), WEEK_SECONDS, days)
            self.assertGreater(rolled, now, days)

    def test_the_session_window_is_five_hours_from_its_own_reset(self):
        start, reset, source = self.bounds(
            json.dumps({"current_session": {"resets_at": "2026-09-13T14:10:00+09:00"},
                        "current_week": {"resets_at": "2026-09-14T09:00:00+09:00"}}),
            key="current_session", length=SESSION_SECONDS)
        self.assertEqual(start.isoformat(), "2026-09-13T09:10:00+09:00")
        self.assertEqual(reset.isoformat(), "2026-09-13T14:10:00+09:00")
        self.assertEqual(source, "usage_cache")

    def test_a_passed_session_reset_is_carried_in_five_hour_steps(self):
        start, reset, source = self.bounds(
            json.dumps({"current_session": {"resets_at": "2026-09-13T04:10:00+09:00"}}),
            key="current_session", length=SESSION_SECONDS)
        self.assertEqual(reset.isoformat(), "2026-09-13T14:10:00+09:00")
        self.assertEqual(source, "usage_cache_rolled")

    def test_the_helper_asks_for_both_windows(self):
        self.assertEqual([name for name, *_ in cost.WINDOWS], ["session", "week"])
        lengths = {name: length for name, length, _, _ in cost.WINDOWS}
        self.assertEqual(lengths, {"session": SESSION_SECONDS, "week": WEEK_SECONDS})

    def test_each_window_names_the_gauge_it_is_measured_against(self):
        # cost 側の窓と quota gauge の窓は別の語彙である。対応を取り違えると、
        # 5H の行が 7D のクォータを按分した値になり、**合計だけは合う。**
        gauges = {name: gauge for name, _, _, gauge in cost.WINDOWS}
        self.assertEqual(gauges, {"session": "session", "week": "weekly_all"})

    def test_a_reset_without_an_offset_is_unreadable(self):
        # parse はできるが aware な now と比べた瞬間に TypeError になり、
        # cache を読めなかった時の退避経路を通らずに実行ごと落ちる。
        start, reset, source = self.bounds(
            json.dumps({"current_week": {"resets_at": "2026-09-14T09:00:00"}}))
        self.assertEqual(source, "fallback_length")
        self.assertIsNone(reset)

    def test_an_unreadable_usage_cache_falls_back_to_a_plain_week(self):
        for payload in (None, "{", "{}", json.dumps({"current_week": {}}),
                        json.dumps({"current_week": {"resets_at": "tomorrow"}})):
            start, reset, source = self.bounds(payload)
            self.assertEqual(source, "fallback_length", payload)
            self.assertIsNone(reset)
            self.assertEqual(start.isoformat(), "2026-09-06T12:00:00+09:00")


class ParseTests(unittest.TestCase):
    def test_a_vector_is_read_into_label_sets_and_values(self):
        parsed = cost.parse_vector(vector([({"session_id": "s1"}, 1.5)]))
        self.assertEqual(parsed, [({"session_id": "s1"}, 1.5)])

    def test_a_response_that_cannot_be_read_is_not_an_empty_result(self):
        # 引けなかったことと 1 件も無かったことを混ぜると、Grafana が答えなく
        # なった時に空の画面を正しい答えとして公開してしまう。
        for payload in ("", "{", "[]", json.dumps({"status": "error", "error": "boom"}),
                        json.dumps({"status": "success", "data": {"resultType": "matrix",
                                                                  "result": []}}),
                        json.dumps({"status": "success", "data": {"resultType": "vector",
                                                                  "result": [{"metric": {}}]}}),
                        json.dumps({"status": "success", "data": {"resultType": "vector",
                                                                  "result": [{"metric": {},
                                                                              "value": [1, "x"]}]}})):
            with self.assertRaises(cost.CostError, msg=payload):
                cost.parse_vector(payload)

    def test_an_empty_vector_is_an_answer(self):
        self.assertEqual(cost.parse_vector(vector([])), [])


class FailureDetailTests(unittest.TestCase):
    """gcx は失敗の詳細を stdout へ書き、stderr は空のまま終了する (実測)。"""

    ENVELOPE = json.dumps({
        "type": "gcx.error", "schema_version": "1",
        "error": {"summary": "Invalid PromQL query", "exitCode": 1,
                  "details": "bad_data: invalid parameter \"query\":\n1:9: parse error",
                  "suggestions": ["Run 'gcx metrics query --help'"]},
    })

    def test_the_detail_comes_from_the_error_envelope_on_stdout(self):
        line = cost.failure_detail(self.ENVELOPE, "", 1)
        self.assertIn("Invalid PromQL query", line)
        self.assertIn("1:9: parse error", line)
        self.assertNotIn("\n", line)

    def test_stderr_is_used_when_there_is_no_envelope(self):
        self.assertEqual(cost.failure_detail("", "boom\n", 3), "boom")

    def test_an_unparsable_stdout_is_reported_as_it_stands(self):
        self.assertEqual(cost.failure_detail("panic: nil map\n", "", 2), "panic: nil map")

    def test_a_silent_failure_still_names_the_exit_status(self):
        self.assertEqual(cost.failure_detail("", "", 137), "exit status 137")

    def test_a_query_failure_carries_the_detail(self):
        with tempfile.TemporaryDirectory() as root:
            fake = Path(root) / "gcx"
            fake.write_text("#!/bin/sh\ncat <<'JSON'\n" + self.ENVELOPE + "\nJSON\nexit 1\n")
            fake.chmod(0o755)
            with self.assertRaises(cost.CostError) as raised:
                cost.run_query({"gcx": str(fake), "context": "", "datasource": "d",
                                "timeout": 10}, "up")
            self.assertIn("Invalid PromQL query", str(raised.exception))


class RowTests(unittest.TestCase):
    def info(self):
        return {"s1": {"session_name": "#1 一番", "project": "p"},
                "s2": {"session_name": "#2 二番", "project": "p"}}

    def test_rows_are_sorted_by_cost(self):
        rows, _ = cost.build_rows({"s1": 1.0, "s2": 5.0}, {}, self.info())
        self.assertEqual([row["session_name"] for row in rows], ["#2 二番", "#1 一番"])

    def test_the_order_does_not_follow_the_quota(self):
        # クォータは按分値で、同じ消費でも刻みの取り方で前後する。行の位置が
        # 問いによって動かない方 (cost) を鍵にする。
        rows, _ = cost.build_rows({"s1": 5.0, "s2": 1.0}, {"s1": 1.0, "s2": 9.0},
                                  self.info())
        self.assertEqual([row["session_id"] for row in rows], ["s1", "s2"])

    def test_no_row_is_left_out_however_many_there_are(self):
        # 行を切ると、切った分が total にだけ残って内訳と突き合わせられず、
        # 読む側が label で絞った画面も黙って少なく出る。
        costs = {f"s{n}": float(n + 1) for n in range(300)}
        info = {f"s{n}": {"session_name": str(n)} for n in range(300)}
        rows, unresolved = cost.build_rows(costs, {}, info)
        self.assertEqual(len(rows), 300)
        self.assertEqual(unresolved, {"cost": 0.0, "quota": 0.0, "sessions": 0})
        self.assertAlmostEqual(sum(row["cost"] for row in rows), sum(costs.values()))

    def test_a_session_known_only_by_its_project_still_gets_a_row(self):
        # 題がまだ付いていない session も info は持ち、project が入る。
        # project の分かる行は「不明」より情報がある。
        rows, unresolved = cost.build_rows(
            {"s1": 1.0}, {}, {"s1": {"project": "overline-zebar"}})
        self.assertEqual([row["project"] for row in rows], ["overline-zebar"])
        self.assertEqual(unresolved["sessions"], 0)

    def test_a_session_whose_info_carries_no_labels_still_gets_a_row(self):
        # emitter は session_id 以外を任意にしている。cwd が "/" の session は
        # project が空になり、写せる label が 1 つも無い形で届く。
        rows, unresolved = cost.build_rows({"s1": 5.0}, {}, {"s1": {}})
        self.assertEqual([row["session_id"] for row in rows], ["s1"])
        self.assertEqual(unresolved["sessions"], 0)

    def test_a_session_without_a_name_becomes_unresolved(self):
        # 落とすと合計が合わなくなる。別マシンから送られた session が該当する。
        rows, unresolved = cost.build_rows(
            {"s1": 1.0, "elsewhere": 9.0}, {"elsewhere": 4.0}, self.info())
        self.assertEqual([row["session_id"] for row in rows], ["s1"])
        self.assertEqual(unresolved, {"cost": 9.0, "quota": 4.0, "sessions": 1})

    def test_the_parts_add_up_to_the_total(self):
        costs = {"s1": 1.0, "s2": 5.0, "elsewhere": 9.0, "idle": 0.0}
        rows, unresolved = cost.build_rows(costs, {}, self.info())
        shown = sum(row["cost"] for row in rows)
        self.assertAlmostEqual(shown + unresolved["cost"], sum(costs.values()))

    def test_the_quota_parts_add_up_too(self):
        points = {"s1": 1.5, "s2": 5.5, "elsewhere": 9.0}
        rows, unresolved = cost.build_rows(
            {"s1": 1.0, "s2": 1.0, "elsewhere": 1.0}, points, self.info())
        shown = sum(row["quota"] for row in rows)
        self.assertAlmostEqual(shown + unresolved["quota"], sum(points.values()))

    def test_an_amount_below_a_cent_is_still_spend(self):
        # 閾値で落とすと、その額が total から消えるか、消えないなら内訳と
        # 合わなくなる。実測でも 0 と $0.005 の間の値は 1 件も無かった。
        rows, unresolved = cost.build_rows({"s1": 0.004, "elsewhere": 0.001},
                                           {}, self.info())
        self.assertEqual([row["cost"] for row in rows], [0.004])
        self.assertEqual(unresolved["cost"], 0.001)

    def test_sessions_that_spent_nothing_are_dropped(self):
        # 窓の中に居ただけで使っていない session。実測で 5H の 10 系列中 7 件。
        # `increase()` はそれを厳密に 0 で返す。
        rows, unresolved = cost.build_rows({"s1": 0.0, "gone": 0.0}, {}, self.info())
        self.assertEqual(rows, [])
        self.assertEqual(unresolved, {"cost": 0.0, "quota": 0.0, "sessions": 0})

    def test_a_session_with_quota_but_no_cost_still_gets_a_row(self):
        # cost は窓ぜんぶを 1 本の `increase` で引き、quota は 5 分刻みで引く。
        # 別の引き方なので、片方にしか出ない session がありうる。**落とすと
        # その行のクォータが合計から消える。**
        rows, unresolved = cost.build_rows({}, {"s1": 2.0}, self.info())
        self.assertEqual([(row["session_id"], row["quota"]) for row in rows],
                         [("s1", 2.0)])
        self.assertEqual(unresolved["sessions"], 0)

    def test_the_order_does_not_depend_on_dictionary_order(self):
        rows, _ = cost.build_rows({"s2": 5.0, "s1": 5.0}, {}, self.info())
        self.assertEqual([row["session_id"] for row in rows], ["s1", "s2"])


class SessionInfoTests(unittest.TestCase):
    def info_from(self, samples):
        with mock.patch.object(cost, "run_query", return_value=samples):
            return cost.session_info({})

    def test_labels_are_copied_from_the_series(self):
        found = self.info_from([({"session_id": "s1", "session_name": "#1 一番",
                                  "custom_title": "#1 一番", "ai_title": "生成された題",
                                  "task_id": "1", "project": "p", "cwd": "/home/u/p"}, 1.0)])
        self.assertEqual(found["s1"], {"session_name": "#1 一番", "custom_title": "#1 一番",
                                       "ai_title": "生成された題", "task_id": "1",
                                       "project": "p", "cwd": "/home/u/p"})

    def test_collector_labels_are_not_copied(self):
        # session の属性ではなく、収集側の設定で変わる。読む側の絞り込みの
        # 語彙に入れると、scrape の設定変更で黙って消える。
        found = self.info_from([({"session_id": "s1", "project": "p", "instance": "host",
                                  "job": "integrations/node_exporter",
                                  "agent_hostname": "box", "__name__": "claude_session_info"}, 1.0)])
        self.assertEqual(found["s1"], {"project": "p"})

    def test_two_series_for_one_session_yield_no_name(self):
        # どちらが正かを決める情報が無い。名前を付けずに「不明」へ送る方が、
        # 別の session の名前を出すより軽い。
        found = self.info_from([({"session_id": "s1", "session_name": "古い"}, 1.0),
                                ({"session_id": "s1", "session_name": "新しい"}, 1.0)])
        self.assertIsNone(found["s1"])
        rows, unresolved = cost.build_rows({"s1": 3.0}, {"s1": 2.0}, found)
        self.assertEqual(rows, [])
        self.assertEqual(unresolved, {"cost": 3.0, "quota": 2.0, "sessions": 1})


class WindowCostTests(unittest.TestCase):
    def test_the_first_sample_is_added_back_per_session(self):
        queries = []

        def fake(config, expression, at=None):
            queries.append((expression, at))
            if expression.startswith("sum by (session_id) (increase"):
                return [({"session_id": "s1"}, 10.0), ({"session_id": "s2"}, 4.0)]
            return [({"session_id": "s1"}, 2.0)]

        with mock.patch.object(cost, "run_query", side_effect=fake):
            totals = cost.window_cost({}, 1000.0, 4600.0)
        self.assertEqual(totals, {"s1": 12.0, "s2": 4.0})
        self.assertIn("[3600s]", queries[0][0])
        # 窓の起点に在った系列を外すのは `unless` の側で、加算は helper が行う。
        # PromQL の `+` は内部結合で、`unless` が除いた系列を加算ごと落とす。
        self.assertIn("unless", queries[1][0])
        self.assertNotIn("+", queries[1][0])
        # 3 本が別々の瞬間を見ないよう、評価時刻を捕まえた now へ固定する。
        self.assertEqual([at for _, at in queries], [4600.0, 4600.0])

    def test_the_addback_is_anchored_at_the_window_start(self):
        with mock.patch.object(cost, "run_query", return_value=[]) as query:
            cost.window_cost({}, 1788739200.0, 1789304700.0)
        self.assertIn("@ 1788739200", query.call_args_list[1].args[1])
        self.assertEqual(query.call_args_list[1].args[2], 1789304700.0)

    def test_the_evaluation_time_reaches_the_command_line(self):
        captured = {}

        class FakeCompleted:
            returncode = 0
            stdout = vector([]).encode()
            stderr = b""

        def fake_run(command, **kwargs):
            captured["command"] = command
            return FakeCompleted()

        with mock.patch.object(cost.subprocess, "run", side_effect=fake_run):
            cost.run_query({"gcx": "gcx", "context": "", "datasource": "d", "timeout": 1},
                           "up", 1789304700.0)
        self.assertIn("--time", captured["command"])
        self.assertEqual(captured["command"][captured["command"].index("--time") + 1],
                         "1789304700")


class OutputTests(unittest.TestCase):
    # reset を報告する cache を置く。**起点が reset でない窓はクォータを引かずに
    # 降りる**ので、`absent.json` のままだと gauge を引く 2 本が消え、この class は
    # コストの経路だけを見ることになる。
    USAGE_CACHE = json.dumps({
        "current_week": {"resets_at": "2026-09-14T09:00:00+09:00"},
        "current_session": {"resets_at": "2026-09-13T14:00:00+09:00"},
    })

    def output(self, costs, info, seen=None):
        def fake(config, expression, at=None):
            if seen is not None:
                seen.append(at)
            if expression.startswith(cost.INFO_METRIC):
                return [({"session_id": key, **labels}, 1.0)
                        for key, labels in info.items()]
            if "increase" in expression:
                return [({"session_id": key}, value) for key, value in costs.items()]
            return []

        with tempfile.TemporaryDirectory() as root:
            path = Path(root) / "usage.json"
            path.write_text(self.USAGE_CACHE)
            with mock.patch.object(cost, "run_query", side_effect=fake):
                return cost.build_output(
                    {"usage_cache": str(path)},
                    dt.datetime.fromisoformat(
                        "2026-09-13T12:00:00+09:00"))["windows"]["week"]

    def parts(self, built):
        return sum(row["cost"] for row in built["sessions"]) + built["unresolved"]["cost"]

    def test_the_reported_parts_add_up_to_the_reported_total(self):
        built = self.output({"s1": 0.0050004, "s2": 0.0050004, "elsewhere": 0.0050004},
                            {"s1": {"session_name": "一番"}, "s2": {"session_name": "二番"}})
        self.assertEqual(built["total"], self.parts(built))

    def test_the_amounts_are_not_rounded(self):
        # 表示の精度は読む側が決める。ここで丸めると、行ごとの丸めと合計の
        # 丸めが食い違い、但し書きが要る。
        built = self.output({"s1": 0.00500049999, "elsewhere": 0.1234567891},
                            {"s1": {"session_name": "一番"}})
        self.assertEqual(built["sessions"][0]["cost"], 0.00500049999)
        self.assertEqual(built["unresolved"]["cost"], 0.1234567891)

    def test_every_query_is_evaluated_at_the_same_instant(self):
        # 題が書き換わる瞬間をまたぐと、別の瞬間の label を凍らせたコストへ付ける。
        seen = []
        self.output({"s1": 1.0}, {"s1": {"session_name": "一番"}}, seen=seen)
        # 窓 2 つ × (コスト 2 本 + クォータの実測 1 本) + 名前 1 本。
        # 名前は窓ごとに引き直さない。
        self.assertEqual(len(seen), 7)
        self.assertEqual(len(set(seen)), 1)
        self.assertIsNotNone(seen[0])

    def test_both_windows_are_reported(self):
        def fake(config, expression, at=None):
            if expression.startswith(cost.INFO_METRIC):
                return [({"session_id": "s1", "session_name": "一番"}, 1.0)]
            if "increase" in expression:
                return [({"session_id": "s1"}, 1.0)]
            return []

        with mock.patch.object(cost, "run_query", side_effect=fake):
            built = cost.build_output(
                {"usage_cache": "absent.json"},
                dt.datetime.fromisoformat("2026-09-13T12:00:00+09:00"))
        self.assertEqual(sorted(built["windows"]), ["session", "week"])
        session, week = built["windows"]["session"], built["windows"]["week"]
        self.assertEqual((dt.datetime.fromisoformat(session["starts_at"])
                          - dt.datetime.fromisoformat(built["generated_at"])).total_seconds(),
                         -SESSION_SECONDS)
        self.assertEqual((dt.datetime.fromisoformat(week["starts_at"])
                          - dt.datetime.fromisoformat(built["generated_at"])).total_seconds(),
                         -WEEK_SECONDS)


class QuotaTests(unittest.TestCase):
    """按分そのもの。`window_quota` は gauge の読みとコストの増分を受け取る。"""

    CONFIG = {"gcx": "gcx", "context": "", "datasource": "d", "timeout": 1}

    def apportion(self, readings, costs, measured, start=1000, now=3000):
        """`readings`/`costs` は `{時刻: 値}` / `{時刻: {session: 額}}`。"""
        def fake(config, expression, start_ts, end_ts):
            if cost.QUOTA_METRIC in expression:
                return [(moment, {"window": "session"}, value)
                        for moment, value in readings.items()]
            return [(moment, {"session_id": key}, value)
                    for moment, row in costs.items() for key, value in row.items()]

        with mock.patch.object(cost, "run_range_query", side_effect=fake):
            return cost.window_quota(self.CONFIG, "session", start, now, measured)

    def test_the_parts_add_up_to_the_measured_reading(self):
        # 達成条件。行と「帰属できない分」の合計が、按分した相手そのものに
        # 一致する。**これが崩れたら、画面の内訳は上の数字の内訳ではない。**
        points, unattributed = self.apportion(
            {1500: 2.0, 2000: 5.0, 2500: 5.0},
            {1400: {"a": 1.0}, 1900: {"a": 1.0, "b": 3.0}, 2400: {"b": 2.0}},
            measured=9.0)
        self.assertAlmostEqual(sum(points.values()) + unattributed, 9.0)

    def test_the_window_starts_at_zero(self):
        # 窓は reset 直後の 0 から始まる。最初の読みまでの上昇を落とすと、
        # **窓の頭が消える** (実測で 5H の窓の 3 のうち 2)。
        points, unattributed = self.apportion(
            {1500: 4.0}, {1200: {"a": 1.0}}, measured=4.0)
        self.assertAlmostEqual(points["a"], 4.0)
        self.assertEqual(unattributed, 0.0)

    def test_the_tail_after_the_last_reading_is_not_lost(self):
        # range query の最後のサンプルから `now` までは、どんな PromQL を
        # 書いても式の外に出る。`measured` で留めて拾う。
        points, unattributed = self.apportion(
            {1500: 4.0}, {1200: {"a": 1.0}, 2800: {"b": 1.0}}, measured=7.0)
        self.assertAlmostEqual(points["a"], 4.0)
        self.assertAlmostEqual(points["b"], 3.0)

    def test_spend_between_two_readings_of_the_same_value_still_counts(self):
        # gauge は整数でしか報告されない。固定幅のバケットで見ると「コストは
        # あるが上昇 0」のバケットが出て、**そのコストは配分に 1 円も効かない**
        # (実測で窓のコストの 35%)。区切りを gauge の目盛りに置けば効く。
        points, _ = self.apportion(
            {1500: 0.0, 2000: 0.0, 2500: 6.0},
            {1400: {"quiet": 1.0}, 2400: {"loud": 1.0}},
            measured=6.0)
        self.assertAlmostEqual(points["quiet"], 3.0)
        self.assertAlmostEqual(points["loud"], 3.0)

    def test_a_rise_with_no_spend_beside_it_is_not_spread(self):
        # 他の machine の CLI が OTel を送っていない時にここへ来る。寄せると
        # 手元の session が一律に膨らむ。
        points, unattributed = self.apportion(
            {1500: 4.0, 2500: 10.0}, {2400: {"a": 1.0}}, measured=10.0)
        self.assertAlmostEqual(unattributed, 4.0)
        self.assertAlmostEqual(points["a"], 6.0)

    def test_spend_outside_the_window_does_not_take_a_share(self):
        points, _ = self.apportion(
            {1500: 6.0}, {500: {"before": 1.0}, 1400: {"inside": 1.0}}, measured=6.0)
        self.assertEqual(list(points), ["inside"])

    def test_a_fall_is_not_added_back(self):
        # 下降は窓の中には現れない。現れたら窓の境界が gauge とずれており、
        # 足し戻すと前の窓の消費が混ざる。
        points, _ = self.apportion(
            {1500: 9.0, 2000: 2.0}, {1400: {"a": 1.0}, 1900: {"a": 1.0}}, measured=2.0)
        self.assertAlmostEqual(points["a"], 9.0)


class RangeQueryTests(unittest.TestCase):
    CONFIG = {"gcx": "gcx", "context": "", "datasource": "d", "timeout": 1}

    def spans(self, start, end):
        asked = []

        def fake(config, extra, expression):
            asked.append((int(extra[1]), int(extra[3])))
            # **進まない分割は落ちずに回り続ける。**回数で打ち切って、
            # 「戻らない」を assert できる失敗に変える。
            if len(asked) > 32:
                raise AssertionError(f"run_range_query did not advance: {asked[-3:]}")
            return json.dumps({"status": "success",
                               "data": {"resultType": "matrix", "result": []}})

        with mock.patch.object(cost, "run_gcx", side_effect=fake):
            cost.run_range_query(self.CONFIG, "up", start, end)
        return asked

    def test_a_long_window_is_split(self):
        # **gcx は range の点数で step を勝手に上げる** (実測: 300s が通るのは
        # 12h までの 145 点。7d を 1 発で投げると 900s になる)。上がったことは
        # 応答からは分からないので、頼んだ刻みが返る長さに割る。
        asked = self.spans(0, 7 * 86400)
        self.assertEqual(len(asked), 14)
        self.assertEqual(asked[0], (0, cost.QUOTA_CHUNK))
        self.assertEqual(asked[-1][1], 7 * 86400)
        for (_, before), (after, _) in zip(asked, asked[1:]):
            self.assertEqual(before, after)

    def test_a_short_window_is_one_query(self):
        self.assertEqual(self.spans(1000, 2000), [(1000, 2000)])

    def test_a_fractional_end_does_not_repeat_the_last_span(self):
        # 片方だけを int にすると、`moment < end_ts` が真のまま `stop` が
        # `moment` に等しくなり、**同じ span を投げ続けて戻らない。**
        self.assertEqual(self.spans(1000.0, 2000.75), [(1000, 2000)])

    def test_an_empty_instant_response_is_refused(self):
        # 中身のある instant は `values` が無くて落ちるが、**空の instant は
        # 「窓の中に 1 点も無かった」と見分けが付かない。**そのまま通すと、
        # gauge を引けなかった窓が「クォータが 1 も動いていない窓」になる。
        with mock.patch.object(cost, "run_gcx", return_value=vector([])):
            with self.assertRaises(cost.CostError):
                cost.run_range_query(self.CONFIG, "up", 1000, 2000)


class QuotaFailureTests(unittest.TestCase):
    """クォータが出せない時も cost 列は出る。出せない理由は 3 通りある。"""

    def build(self, fail_on=None, reset="2026-09-14T09:00:00+09:00"):
        ranges = []

        def fake_query(config, expression, at=None):
            if cost.QUOTA_METRIC in expression:
                if fail_on == "measured":
                    raise cost.CostError("no gauge")
                return [] if fail_on == "silent" else [({"window": "weekly_all"}, 25.0)]
            if expression.startswith(cost.INFO_METRIC):
                return [({"session_id": "s1", "session_name": "一番"}, 1.0)]
            if "increase" in expression:
                return [({"session_id": "s1"}, 4.0)]
            return []

        def fake_range(config, expression, start_ts, end_ts):
            ranges.append(expression)
            if fail_on == "range":
                raise cost.CostError("range refused")
            return []

        with tempfile.TemporaryDirectory() as root:
            path = Path(root) / "usage.json"
            if reset is not None:
                path.write_text(json.dumps({"current_week": {"resets_at": reset}}))
            with mock.patch.object(cost, "run_query", side_effect=fake_query), \
                    mock.patch.object(cost, "run_range_query", side_effect=fake_range):
                built = cost.build_output(
                    {"usage_cache": str(path)},
                    dt.datetime.fromisoformat("2026-09-13T12:00:00+09:00"))
        return built["windows"]["week"], ranges

    def assert_cost_still_there(self, built):
        self.assertIsNone(built["quota"])
        self.assertEqual(built["total"], 4.0)
        self.assertEqual(built["sessions"][0]["session_name"], "一番")

    def test_a_refused_quota_query_leaves_the_cost_standing(self):
        # 窓ぶんの range query は 7 日で 28 本あり、cost 側は 3 本である。
        # ここの失敗で cache ごと前回の写しへ落ちると、**28 本ある側の失敗率が、
        # 3 本しかない側の鮮度を決める。**
        for fail_on in ("measured", "range", "silent"):
            with self.subTest(fail_on=fail_on):
                with contextlib.redirect_stderr(io.StringIO()):
                    built, _ = self.build(fail_on)
                self.assert_cost_still_there(built)

    def test_a_window_whose_start_is_not_a_reset_gets_no_quota(self):
        # 按分は「窓の起点で 0 だった」ことに全面的に乗っている。reset を 1 つも
        # 読めず今から window 長だけ戻しただけの窓は起点が reset ではなく、
        # そこにあった残高が起点直後の上昇として現れる。**その時に動いていた
        # session へ最大で窓ぜんぶが付く。**
        with contextlib.redirect_stderr(io.StringIO()):
            built, ranges = self.build(reset=None)
        self.assertEqual(built["source"], "fallback_length")
        self.assert_cost_still_there(built)
        # 引かずに降りる。引いてから捨てるのでは 28 本ぶんの時間を毎回捨てる。
        self.assertEqual(ranges, [])

    def test_a_rolled_reset_still_gets_a_quota(self):
        # 窓単位で送った reset は reset のままなので、起点は 0 である。
        built, _ = self.build(reset="2026-09-07T09:00:00+09:00")
        self.assertEqual(built["source"], "usage_cache_rolled")
        self.assertIsNotNone(built["quota"])


class CacheTests(unittest.TestCase):
    def helper(self, root, argv, gcx="true"):
        environment = {
            "CLAUDE_COST_CACHE_DIR": str(root),
            "CLAUDE_COST_GCX_BIN": gcx,
            "CLAUDE_COST_USAGE_CACHE": str(Path(root) / "absent.json"),
        }
        with mock.patch.dict(os.environ, environment), \
                contextlib.redirect_stderr(io.StringIO()) as complaint:
            stream = io.BytesIO()
            with mock.patch.object(sys, "stdout", mock.Mock(buffer=stream)):
                code = cost.main(argv)
        return code, stream.getvalue().decode(), complaint.getvalue()

    def test_a_failed_query_keeps_the_previous_reading(self):
        # `generated_at` が動かないことで、読む側から停止が見える。
        with tempfile.TemporaryDirectory() as root:
            previous = '{"generated_at":"2026-09-01T00:00:00+09:00","total":1}'
            (Path(root) / "cost.json").write_text(previous)
            code, printed, complaint = self.helper(root, ["--force"], gcx="false")
            self.assertEqual(code, 0)
            self.assertEqual(printed, previous)
            self.assertEqual((Path(root) / "cost.json").read_text(), previous)
            self.assertIn("claude cost:", complaint)

    def test_a_failed_query_without_a_previous_reading_says_so(self):
        with tempfile.TemporaryDirectory() as root:
            code, printed, _ = self.helper(root, ["--force"], gcx="false")
            self.assertEqual(code, 69)
            self.assertEqual(printed, "")

    def test_cached_only_never_runs_a_query(self):
        with tempfile.TemporaryDirectory() as root:
            (Path(root) / "cost.json").write_text('{"total":1}')
            code, printed, _ = self.helper(
                root, ["--cached-only"], gcx="/nonexistent/gcx")
            self.assertEqual(code, 0)
            self.assertEqual(printed, '{"total":1}')

    def test_cached_only_reports_a_missing_cache(self):
        with tempfile.TemporaryDirectory() as root:
            code, printed, complaint = self.helper(root, ["--cached-only"])
            self.assertEqual(code, 66)
            self.assertEqual(printed, "")
            self.assertIn("not available yet", complaint)


