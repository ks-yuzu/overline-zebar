        self.assertIn(cost.RESET_METRIC, expression)
        # 前の窓の reset はこの窓の起点そのもの。`>` でちょうど外れる。
        self.assertIn("> 1789416600", expression)

    def test_both_sides_of_the_pairing_read_over_the_same_lookback(self):
