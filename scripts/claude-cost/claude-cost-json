COST_METRIC = "claude_code_cost_usage_USD_total"
INFO_METRIC = "claude_session_info"
QUOTA_METRIC = "claude_usage_used_percent"

# 名前・窓の長さ・usage cache内のkey・quota gaugeの`window` label。
# **window長はhelperの外にも写しがある**
# (docs/ai-usage-integration.md「window長は複数箇所に重複している」)。
# providerが変えた時は揃える。
WINDOWS = (
    ("session", 5 * 3600, "current_session", "session"),
    ("week", 7 * 86400, "current_week", "weekly_all"),
)

# quotaの按分で使うrange queryの刻みと、1本で引く長さの上限。
# **gcxはrangeの点数でstepを勝手に上げる** (実測: 300sが通るのは12hまでの145点。
# 18hを投げると600sへ、7dを1発で投げると900sになる)。上がったことは応答からは
# 分からないため、12hずつに割って繋ぐ。
QUOTA_STEP = 300
QUOTA_CHUNK = 12 * 3600

DEFAULT_DATASOURCE = "grafanacloud-prom"
DEFAULT_TIMEOUT = 30.0
DEFAULT_TTL = 240.0
# infoから写すlabel。表示名の組み立ても絞り込みも読む側が持つ。emitterが出す
# labelはすべて写す。**scrapeが付けるlabel (`agent_hostname` `instance` `job`) は
# 写さない。**sessionの属性ではなく、収集側の設定で変わる。
INFO_LABELS = ("session_name", "custom_title", "ai_title", "task_id", "project", "cwd")


class CostError(Exception):
    pass


def env_value(name, default):
    value = os.environ.get(name, "").strip()
    return value or default


def positive_env(name, default):
    raw = os.environ.get(name, "").strip()
    if not raw:
        return default
    try:
        value = float(raw)
    except ValueError:
        return default
    return value if value > 0 else default


def parse_iso8601(value):
    """offsetを持つ日時だけを受ける。

    offsetの無い日時もparseはできるが、awareな`now`と比べた瞬間にTypeErrorに
    なる。`main`はCostErrorしか捕まえないため、**cacheを読めなかった時の
    退避経路を通らずに実行ごと落ちる。**読めない値として扱い、窓の側の
    fallbackに載せる。
    """
    if not isinstance(value, str) or not value:
        return None
    try:
        moment = dt.datetime.fromisoformat(value)
    except ValueError:
        return None
    return moment if moment.tzinfo is not None else None


def read_usage_cache(path):
    try:
        payload = json.loads(Path(path).read_bytes())
        return payload if isinstance(payload, dict) else {}
    except (OSError, ValueError):
        return {}


def window_bounds(payload, key, length, now):
    """windowの起点と終端を返す。

    起点はusage helperが報告するresetからwindow長だけ戻して求める。読めない
    場合は今からwindow長だけ戻した窓に落とす。**どちらで求めたかを出力に
    残す。**同じ形の数字が別の窓から来ていることが、後から見て分からなくなる。
    """
    try:
        reset = parse_iso8601(payload[key]["resets_at"])
    except (KeyError, TypeError):
        reset = None
    if reset is None:
        return now - dt.timedelta(seconds=length), None, "fallback_length"
    source = "usage_cache"
    if reset <= now:
        # usage cacheがresetをまたいで止まっていると、報告されたresetは前の窓の
        # ものになる。そのまま使うと窓がwindow長より長くなり、**window長でない
        # 期間を「今の窓」として公開する。**window長は既に`reset - 長さ`で前提に
        # しているので、同じ前提で今の窓へ送る。
        # **この規則が偽になる観測:** providerがwindow長を変えると、ここが出す
        # 窓は静かにずれる。chipのcount downと`window.resets_at`が食い違う。
        elapsed = (now - reset).total_seconds()
        periods = int(elapsed // length) + 1
        reset += dt.timedelta(seconds=periods * length)
        source = "usage_cache_rolled"
    return reset - dt.timedelta(seconds=length), reset, source


def parse_vector(payload):
    """instant queryの応答をlabel setごとの値にする。

    形が合わない応答は0件ではなく例外にする。**引けなかったことと、
    1件も無かったことを混ぜない。**混ぜると、Grafanaが答えなくなった時に
    全部の行が消えた画面を、正しい答えとして公開してしまう。
    """
    try:
        data = json.loads(payload)
        result = data["data"]["result"]
        if data["data"].get("resultType") != "vector":
            raise CostError("query did not return an instant vector")
    except (ValueError, KeyError, TypeError) as error:
        raise CostError(f"cannot read the query response: {error}")
    values = []
    for item in result:
        try:
            values.append((item["metric"], float(item["value"][1])))
        except (KeyError, IndexError, TypeError, ValueError) as error:
            raise CostError(f"cannot read a sample: {error}")
    return values


def by_session(values):
    totals = {}
    for metric, value in values:
        session_id = metric.get("session_id")
        if session_id:
            totals[session_id] = totals.get(session_id, 0.0) + value
    return totals


def failure_detail(stdout, stderr, code):
    """失敗の理由を1行にする。

    **gcxは失敗の詳細をstdoutへ書き、stderrは空のまま終了する** (実測)。
    stderrだけを見ると、cronのlogに残るのは終了コードだけになり、
    唯一の手がかりが無内容になる。
    """
    try:
        envelope = json.loads(stdout)["error"]
        summary, details = envelope.get("summary", ""), envelope.get("details", "")
        line = ": ".join(part for part in (summary, details) if part)
    except (ValueError, KeyError, TypeError, AttributeError):
        line = ""
    line = line or stderr.strip() or stdout.strip()
    return " ".join(line.split())[:300] or f"exit status {code}"


def run_query(config, expression, at=None):
    """instant queryを1本投げる。

    `at`を渡すと評価時刻をそこへ固定する。指定しないとgcxが自分のnowで
    評価するため、**3本のqueryが別々の瞬間を見る。**rangeの起点が窓の起点より
    後ろへずれ、窓の起点に在った系列 (足し戻しを抑止する側) では、そのずれの
    間の消費がどちらにも入らない。
    """
    extra = ["--time", str(int(at))] if at is not None else []
    return parse_vector(run_gcx(config, extra, expression))


def run_gcx(config, extra, expression):
    """gcxを1回呼び、応答のJSONを返す。"""
    command = [config["gcx"], "metrics", "query", "-d", config["datasource"], "-o", "json"]
    if config["context"]:
        command += ["--context", config["context"]]
    command += extra
    command.append(expression)
    try:
        completed = subprocess.run(
            command, capture_output=True, timeout=config["timeout"],
            # gcxは助言をstderrへ書く。stdoutは応答だけである。
            stdin=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise CostError(f"cannot run {config['gcx']}: {error}")
    if completed.returncode != 0:
        raise CostError("query failed: " + failure_detail(
            completed.stdout.decode("utf-8", "replace"),
            completed.stderr.decode("utf-8", "replace"),
            completed.returncode,
        ))
    return completed.stdout.decode("utf-8", "replace")


def parse_matrix(payload):
    """range queryの応答を`(時刻, label set, 値)`にする。

    `parse_vector`と同じく、形が合わない応答は0件ではなく例外にする。
    """
    try:
        data = json.loads(payload)
        result = data["data"]["result"]
        if data["data"].get("resultType") != "matrix":
            raise CostError("query did not return a range vector")
    except (ValueError, KeyError, TypeError) as error:
        raise CostError(f"cannot read the query response: {error}")
    samples = []
    for item in result:
        try:
            for moment, value in item["values"]:
                samples.append((int(moment), item["metric"], float(value)))
        except (KeyError, IndexError, TypeError, ValueError) as error:
            raise CostError(f"cannot read a sample: {error}")
    return samples


def run_range_query(config, expression, start_ts, end_ts):
    """窓ぜんぶを`QUOTA_STEP`刻みで引く。

    **1本で投げない。**gcxはrangeが長いとstepを黙って上げるため、頼んだ刻みとは
    別の刻みの答えが、同じ形で返る (`QUOTA_CHUNK`)。
    """
    # **秒より下を先に落とす。**片方だけをintにすると、最後のチャンクで
    # `moment < end_ts`が真のまま`stop`が`moment`に等しくなり、進まなくなる。
    moment, end = int(start_ts), int(end_ts)
    samples = []
    while moment < end:
        stop = min(moment + QUOTA_CHUNK, end)
        samples += parse_matrix(run_gcx(config, [
            "--from", str(moment), "--to", str(stop), "--step", f"{QUOTA_STEP}s",
        ], expression))
        moment = stop
    return samples


def window_cost(config, start_ts, now_ts):
    """窓の中で発生したコストをsessionごとに返す。

    `increase()`だけでは足りない。counterはsession開始時の暗黙の0から始まるが、
    Prometheusはその0を見ず、系列が窓の内側で始まると外挿も効かないため、
    最初のexport 1回分が落ちる (実測で週合計の9%)。窓の起点に在った系列には
    足さない。そこにある値は前の窓の残高である。

    **この2本を1本のPromQLにまとめない。**`A + (B unless C)`は内部結合で、
    `unless`が除いた系列を加算ごと落とす (実測$49.04→$4.46)。窓をまたぐ系列が
    無い週ではこの誤りが再現せず、次の週次resetで初めて出る。
    """
    span = max(int(now_ts - start_ts), 1)
    increase = by_session(run_query(
        config, f"sum by (session_id) (increase({COST_METRIC}[{span}s]))", now_ts))
    addback = by_session(run_query(
        config,
        f"sum by (session_id) (first_over_time({COST_METRIC}[{span}s])"
        f" unless ({COST_METRIC} @ {int(start_ts)}))",
        now_ts,
    ))
    return {key: increase.get(key, 0.0) + addback.get(key, 0.0)
            for key in set(increase) | set(addback)}


def interval_costs(config, start_ts, now_ts):
    """`{区間の時刻: {session_id: その区間の消費}}`。生counterの差で出す。

    **`increase()`を区間ごとに並べない。**系列がその区間の中で始まると、
    Prometheusは暗黙の0を見ないため最初のexportが落ちる。`window_cost`が
    `first_over_time ... unless`で足し戻しているのと同じ欠けだが、こちらは
    **落ちるのが額ではなく取り分なので、その区間に居た他のsessionへそのまま
    回る。**実測 (20h) で合計の11.6%、sessionごとでは-14%〜+60%ずれた。

    **窓の起点に在った系列の残高は、ここでは落とさなくてよい。**range queryの
    刻みは`--from`ではなくstepの絶対境界に揃う (実測) ため、その系列の初値は
    窓の起点かそれより前に載る。按分は起点より後の区間しか見ないので、
    残高はどの区間にも入らない。`window_cost`が`unless`で明示的に抑えているのは、
    あちらが窓ぜんぶを1本のrangeで数えていて、同じ逃げ道が無いためである。
    """
    series = {}
    for moment, metric, value in run_range_query(config, COST_METRIC, start_ts, now_ts):
        session_id = metric.get("session_id")
        if not session_id:
            continue
        key = tuple(sorted((name, metric[name]) for name in metric if name != "__name__"))
        series.setdefault(key, (session_id, {}))[1][moment] = value

    costs = {}
    for session_id, points in series.values():
        previous = 0.0
        for moment, value in sorted(points.items()):
            # 同じsession_idのままresumeするとcounterがリセットされる (実測で
            # 週に5件)。下がったら、そこにある値がreset後の消費そのものである。
            spent = value - previous if value >= previous else value
            previous = value
            if spent > 0:
                row = costs.setdefault(moment, {})
                row[session_id] = row.get(session_id, 0.0) + spent
    return costs


def window_quota(config, quota_window, start_ts, now_ts, measured):
    """窓のクォータ消費をsessionごとに按分する。`(session別, 帰属できない分)`。

    gaugeが上がった時刻を境界にし、その1つ前の上昇から今回までに積まれた
    コストの取り分で、今回の上昇を割る。

    **バケットを固定幅にしない。**gaugeは整数でしか報告されないので、5分幅で
    見ると「コストはあるが上昇0」のバケットが出る (実測で窓のコストの35%)。
    その消費は配分に1円も効かないまま、上昇は後のバケットに整数で現れ、
    その時に動いていたsessionが丸ごと受け取る。区切りをgaugeの目盛り自体に
    置けば、窓の中のコストはすべてどこかの上昇に効く。
    **この規則が偽になる観測:** 1セッションだけが走った区間で、その区間の上昇が
    そのsessionに付く割合。固定幅との比較は経緯 (task #106) にある。

    上昇の合計は`measured`に一致する。**一致を成り立たせているのは両端を
    留めていることで、queryの精度ではない。**窓の中でgaugeが下がったら、
    一致が作れないので`None`を返す。
    """
    # gaugeの値そのものを引き、差はここで取る。**増分をPromQLで作らない。**
    # `delta`も`increase`も外挿するため隣り合う差の合計が端点の差と一致せず、
    # range queryの最後のサンプルから`now`までの分はどう書いても式の外に出る。
    #
    # `max by (window)`で引く。**instanceでは絞らない。**同じaccountの値を
    # 複数のhostが報告しており (実測で2台、24hの上昇は177.0で完全に一致)、
    # 1台を選ぶとその台が止まっていた間の上昇が丸ごと落ちる。
    # `[15m]`は欠測をまたぐためのlookback。飛んでもその先で差が繋がる。
    readings = {}
    for moment, _, value in run_range_query(config, (
        f'max by (window) (last_over_time({QUOTA_METRIC}{{window="{quota_window}"}}[15m]))'
    ), start_ts, now_ts):
        readings[moment] = max(readings.get(moment, 0.0), value)

    # 両端を留める。窓は0から始まり、今の値が`measured`である。**留めないと
    # 合計は「最初のサンプルから最後のサンプルまで」になり、窓の頭と尻尾が
    # 落ちる** (実測で5Hの窓で3のうち2、7Dの窓で25のうち1)。
    inside = [(moment, value) for moment, value in sorted(readings.items())
              if int(start_ts) < moment < int(now_ts)]
    # 窓の中に読みが1つも無いのに`measured`が0でないなら、その値は窓の外から
    # 来ている。**`measured`も`[15m]`のlookbackで引いており、resetの直後は
    # 前の窓の値を返す** (gaugeの書き込みとscrapeがresetに追いつくまで)。
    # 0で留めた起点との差が「窓の頭で一気に消費した」形になり、**reset直後に
    # 動いていたsessionへ前の窓ぶんが付く。**下降が無いので下の検出には掛からない。
    if measured > 0 and not inside:
        return None
    series = [(int(start_ts), 0.0)] + inside + [(int(now_ts), measured)]
    rises = {}
    for (_, before), (moment, after) in zip(series, series[1:]):
        # 下がったら按分をやめる。**上昇だけを拾って下降を飛ばすと、前の窓の
        # 消費が行に残ったまま、見出しは今の窓の値になる** (0→80→0→3で、行の
        # 合計83に対し見出し3)。下降が現れたのは窓の境界がgaugeとずれた時で、
        # **どの窓を見ているのかが分からない。**引けなかった時と同じ扱いにする。
        # **この規則が偽になる観測:** 通常のresetでは下降は現れない。range query
        # のサンプルはstepの境界に揃うため、reset直前の読みは窓の起点より前に
        # 落ちて除かれる (実測、連続する4回のresetすべてで-120秒か-60秒)。
        if after < before:
            return None
        if after > before:
            rises[moment] = after - before

    costs = interval_costs(config, start_ts, now_ts)

    points, unattributed, previous = {}, 0.0, int(start_ts)
    for tick in sorted(rises):
        shares = {}
        for moment, row in costs.items():
            if previous < moment <= tick:
                for session_id, value in row.items():
                    shares[session_id] = shares.get(session_id, 0.0) + value
        total = sum(shares.values())
        if total <= 0:
            # 上昇はあるのに、その間のコストが1件も無い。**どこかへ寄せない。**
            # 他のmachineのCLIがOTelを送っていない時にここへ来るので、寄せると
            # 手元のsessionが一律に膨らむ。
            unattributed += rises[tick]
        else:
            for session_id, value in shares.items():
                points[session_id] = (
                    points.get(session_id, 0.0) + rises[tick] * value / total)
        previous = tick
    return points, unattributed


def quota_for(config, quota_window, start_ts, now_ts, source):
    """按分と、按分した相手の実測値を返す。引けなければ`(空, 0, None)`。

    **クォータが引けないことをcost全体の失敗にしない。**窓ぶんのrange queryは
    7日で28本あり、cost側は3本である。ここの失敗でcacheごと前回の写しへ落ちると、
    **28本ある側の失敗率が、3本しかない側の鮮度を決める。**
    `used_percent`が`None`であることが、按分が無いことを読む側へ伝える。
    """
    # 按分は「窓の起点で0だった」ことに全面的に乗っている。resetを1つも読めず
    # 今からwindow長だけ戻しただけの窓は、起点がresetではない。そこにあった
    # 残高が起点直後の上昇として現れ、**その時に動いていたsessionへ最大で
    # 窓ぜんぶが付く。**costは窓の取り方が多少ずれても額がずれるだけなので、
    # この窓ではcost側だけを出す。
    if source == "fallback_length":
        return {}, 0.0, None
    try:
        measured = run_query(config, (
            f'max by (window) (last_over_time('
            f'{QUOTA_METRIC}{{window="{quota_window}"}}[15m]))'
        ), now_ts)
        if not measured:
            return {}, 0.0, None
        used = max(value for _, value in measured)
        split = window_quota(config, quota_window, start_ts, now_ts, used)
        if split is None:
            return {}, 0.0, None
        points, unattributed = split
        return points, unattributed, used
    except CostError as error:
        print(f"claude cost: quota for {quota_window}: {error}", file=sys.stderr)
        return {}, 0.0, None


def session_info(config, at=None):
    found = {}
    for metric, _ in run_query(config, INFO_METRIC, at):
        session_id = metric.get("session_id")
        if not session_id:
            continue
        # 同じsession_idの系列が2本来たら、どちらが正かを決める情報が無い。
        # 名前を付けずに「不明」へ送る方が、別のsessionの名前を出すより軽い。
        if session_id in found:
            found[session_id] = None
            continue
        found[session_id] = {key: metric[key] for key in INFO_LABELS if metric.get(key)}
    return found


def build_rows(costs, points, info):
    """表示する行と、名前の付かない分を返す。

    **上限を置かない。**行を切ると、切った分が`total`にだけ残って内訳と
    突き合わせられず、読む側がlabelで絞った画面も黙って少なく出る。
    **要求が定まっていない利用者のために、不完全なcacheを作らない。**
    系列数は現実の側で頭打ちになっており (実測で保持期間いっぱいの20日でも
    29件)、抑えるべき増え方が無い。
    """
    rows, unresolved = [], {"cost": 0.0, "quota": 0.0, "sessions": 0}
    for session_id in set(costs) | set(points):
        cost, quota = costs.get(session_id, 0.0), points.get(session_id, 0.0)
        # 窓の中に居ただけで使っていないsession。`increase()`はそれを厳密に0で
        # 返す (実測で5Hの10系列中7件)。**閾値では落とさない。**$0.004も消費で
        # あり、落とせば`total`から消えるか、消えないなら内訳と合わなくなる。
        # 実測でも、0と$0.005の間の値は1件も無かった。
        if not cost and not quota:
            continue
        labels = info.get(session_id)
        # **対応表が無いことと、対応表に写せるlabelが無いことを混ぜない。**
        # emitterは`session_id`以外を任意にしているので、cwdが`/`のsessionは
        # `{}`で届く。それは既知のsessionであり、読む側は`session_id`の先頭で
        # 出せる。`None`は系列が無いか、2本来て決められなかった場合である。
        if labels is None:
            unresolved["cost"] += cost
            unresolved["quota"] += quota
            unresolved["sessions"] += 1
            continue
        rows.append(dict(labels, session_id=session_id, cost=cost, quota=quota))
    # **並べる鍵はcostのまま。**クォータは按分値で、同じ消費でも刻みの取り方で
    # 前後する。行の位置が問いによって動かない方を鍵にする。
    rows.sort(key=lambda row: (-row["cost"], row["session_id"]))
    return rows, unresolved


def build_output(config, now):
    """5Hと7Dの両方について、その窓の消費をsessionごとに返す。

    panelは他のすべての段で2つのwindowを対称に扱う。片方だけ出すと、
    そこだけ別の問いに答える段になる。
    """
    payload = read_usage_cache(config["usage_cache"])
    # 名前は3本のqueryで共有する。**同じ瞬間で評価する**ため、1回だけ引く。
    info = session_info(config, now.timestamp())
    windows = {}
    for name, length, key, quota_window in WINDOWS:
        start, reset, source = window_bounds(payload, key, length, now)
        costs = window_cost(config, start.timestamp(), now.timestamp())
        points, unattributed, measured = quota_for(
            config, quota_window, start.timestamp(), now.timestamp(), source)
        rows, unresolved = build_rows(costs, points, info)
        # **桁を丸めない。**表示の精度は読む側が決める。ここで丸めると、
        # 行ごとの丸めと合計の丸めが食い違い、「行と不明の合計がtotalに
        # 一致する」を成り立たせるために但し書きが要る。
        # 丸めで減るのは実測で98 byte (2%) だけだった。
        windows[name] = {
            "starts_at": start.isoformat(timespec="seconds"),
            "resets_at": reset.isoformat(timespec="seconds") if reset else None,
            "source": source,
            # **`total`は報告する値から積む。**別に数えると、報告しなかった分が
            # totalにだけ残り、内訳と突き合わせられない。
            "total": sum(row["cost"] for row in rows) + unresolved["cost"],
            "sessions": rows,
            "unresolved": unresolved,
            "quota": None if measured is None else {
                # gaugeの現在値。窓は0から始まるので、これが窓の消費そのもの
                # である。**usage cacheの値を写さない。**別の経路・別の瞬間の
                # 読みであり、行を按分した相手はこちらである。
                "used_percent": measured,
                "unattributed": unattributed,
            },
        }
    return {
        "generated_at": now.isoformat(timespec="seconds"),
        "currency": "USD",
        "windows": windows,
    }


def atomic_write(path, data, mode):
    path = Path(path)
    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.tmp.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as temporary:
            temporary.write(data)
        os.replace(temporary_name, path)
    finally:
        Path(temporary_name).unlink(missing_ok=True)


def print_cache(cache, missing_code):
    try:
        if cache.stat().st_size:
            sys.stdout.buffer.write(cache.read_bytes())
            return 0
    except OSError:
        pass
    print("Claude cost cache is not available yet", file=sys.stderr)
    return missing_code


def settings():
    return {
        "gcx": env_value("CLAUDE_COST_GCX_BIN", "gcx"),
        "context": env_value("CLAUDE_COST_GCX_CONTEXT", ""),
        "datasource": env_value("CLAUDE_COST_DATASOURCE", DEFAULT_DATASOURCE),
        "usage_cache": env_value(
            "CLAUDE_COST_USAGE_CACHE", str(Path.home() / ".cache/claude-usage-json/usage.json")
        ),
        "timeout": positive_env("CLAUDE_COST_TIMEOUT", DEFAULT_TIMEOUT),
        "ttl": positive_env("CLAUDE_COST_CACHE_TTL", DEFAULT_TTL),
    }


def main(argv):
    if len(argv) > 1 or (argv and argv[0] not in ("--force", "--cached-only")):
        print(f"usage: {sys.argv[0]} [--force|--cached-only]", file=sys.stderr)
        return 64
    cache_dir = Path(env_value("CLAUDE_COST_CACHE_DIR", str(Path.home() / ".cache/claude-cost-json")))
    cache = cache_dir / "cost.json"
    if argv == ["--cached-only"]:
        return print_cache(cache, 66)

    config = settings()
    try:
        cache_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        cache_dir.chmod(0o700)
        lock = open(cache_dir / "update.lock", "a+")
        os.chmod(lock.name, 0o600)
    except OSError as error:
        print(f"cannot prepare Claude cost cache: {error}", file=sys.stderr)
        return 73

    with lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if argv != ["--force"]:
            try:
                if cache.stat().st_size and time.time() - cache.stat().st_mtime < config["ttl"]:
                    return print_cache(cache, 66)
            except OSError:
                pass
        try:
            output = build_output(config, dt.datetime.now().astimezone())
        except CostError as error:
            # 取れなかった時は前回のcacheをそのまま返す。`generated_at`が
            # 動かないので、読む側から停止が見える。
            print(f"claude cost: {error}", file=sys.stderr)
            return print_cache(cache, 69)
        try:
            # 整形しない。widgetが60秒ごとに読み直すため、indentと\uXXXXの
            # escapeがそのまま転送量になる (題は日本語で、escapeで19%増える)。
            atomic_write(cache, json.dumps(
                output, separators=(",", ":"), ensure_ascii=False).encode(), 0o600)
        except OSError as error:
            print(f"claude cost: cannot write {cache}: {error}", file=sys.stderr)
            return 73
    return print_cache(cache, 66)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
