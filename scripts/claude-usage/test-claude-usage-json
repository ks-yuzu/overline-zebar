    def test_empty_cache_override_uses_default_instead_of_current_directory(self):
        with tempfile.TemporaryDirectory() as directory:
            home = Path(directory) / "home"
            cwd = Path(directory) / "cwd"
            home.mkdir()
            cwd.mkdir()
            before = cwd.stat().st_mode
            env = os.environ.copy() | {"HOME": str(home), "CLAUDE_USAGE_CACHE_DIR": ""}
            result = subprocess.run([SCRIPT, "--cached-only"], cwd=cwd, env=env,
                                    text=True, capture_output=True)
            self.assertEqual(result.returncode, 66)
            self.assertEqual(cwd.stat().st_mode, before)
            self.assertEqual(list(cwd.iterdir()), [])

    def test_prometheus_last_known_and_age_are_both_observable(self):
        now = dt.datetime(2026, 9, 9, 1, 2, 3, tzinfo=dt.timezone(dt.timedelta(hours=9)))
        windows, text = usage.screen_windows("\n".join([
            "Showing last-known usage as of 2h ago", "Current session", "7% 7% used",
            "Resets 4am (Asia/Tokyo)", "Current week (all models)", "44% 44% used",
            "Resets Sep 14, 9am (Asia/Tokyo)",
        ]))
        with tempfile.TemporaryDirectory() as directory:
            output = usage.build_output("screen", windows, text, {}, Path(directory) / "samples", now)
        metrics = usage.prometheus_text(output, {}).decode()
        self.assertIn("claude_usage_generated_timestamp_seconds 1788883323", metrics)
        self.assertIn("claude_usage_refresh_last_known 1", metrics)


