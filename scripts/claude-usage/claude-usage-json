#!/usr/bin/env bash

set -euo pipefail

timeout_seconds="${CLAUDE_USAGE_TIMEOUT:-45}"
if [[ ! "$timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
	printf 'CLAUDE_USAGE_TIMEOUT must be a positive integer\n' >&2
	exit 64
fi

cache_ttl_seconds="${CLAUDE_USAGE_CACHE_TTL:-300}"
if [[ ! "$cache_ttl_seconds" =~ ^[1-9][0-9]*$ ]]; then
	printf 'CLAUDE_USAGE_CACHE_TTL must be a positive integer\n' >&2
	exit 64
fi

session_id="${CLAUDE_USAGE_SESSION_ID:-ca1de000-0000-4000-8000-000000000001}"
if [[ ! "$session_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
	printf 'CLAUDE_USAGE_SESSION_ID must be a valid UUID\n' >&2
	exit 64
fi

force_refresh=false
cached_only=false
case "${1:-}" in
	'') ;;
	--force) force_refresh=true ;;
	--cached-only) cached_only=true ;;
	*)
		printf 'usage: %s [--force|--cached-only]\n' "$0" >&2
		exit 64
		;;
esac

cache_dir="${CLAUDE_USAGE_CACHE_DIR:-$HOME/.cache/claude-usage-json}"
cache_file="$cache_dir/usage.json"
# Append-only archive of raw samples. The cache prunes to 14 days on every
# write, so without this the older history is gone for good and no later
# rollup can be computed for it. The widget never reads this file.
samples_file="$cache_dir/samples.ndjson"
lock_file="$cache_dir/update.lock"
mkdir -p -- "$cache_dir"
chmod 700 -- "$cache_dir"

export CLAUDE_CODE_SKIP_PROMPT_HISTORY=1

if [[ "$cached_only" == true ]]; then
	if [[ ! -s "$cache_file" ]]; then
		printf 'Claude usage cache is not available yet\n' >&2
		exit 66
	fi
	cat -- "$cache_file"
	exit 0
fi

cache_is_fresh() {
	[[ -s "$cache_file" ]] || return 1
	local modified_at now
	modified_at="$(stat -c %Y -- "$cache_file")" || return 1
	now="$(date +%s)"
	((now - modified_at < cache_ttl_seconds))
}

if [[ "$force_refresh" == false ]] && cache_is_fresh; then
	cat -- "$cache_file"
	exit 0
fi

for command_name in expect perl flock; do
	if ! command -v "$command_name" >/dev/null 2>&1; then
		printf 'required command not found: %s\n' "$command_name" >&2
		if [[ -s "$cache_file" ]]; then
			cat -- "$cache_file"
			exit 0
		fi
		exit 69
	fi
done

# The main Zebar widget runs once per monitor. Serialize cache refreshes so only
# one of those processes opens Claude's interactive /usage screen.
exec 9>"$lock_file"
flock 9

if [[ "$force_refresh" == false ]] && cache_is_fresh; then
	cat -- "$cache_file"
	exit 0
fi

default_claude_bin="$HOME/bin/claude"
if [[ ! -x "$default_claude_bin" ]]; then
	default_claude_bin="$(command -v claude || true)"
fi
claude_bin="${CLAUDE_USAGE_CLAUDE_BIN:-$default_claude_bin}"
if [[ -z "$claude_bin" || ! -x "$claude_bin" ]]; then
	printf 'Claude executable not found; set CLAUDE_USAGE_CLAUDE_BIN\n' >&2
	if [[ -s "$cache_file" ]]; then
		cat -- "$cache_file"
		exit 0
	fi
	exit 69
fi

capture_file="$(mktemp "${TMPDIR:-/tmp}/claude-usage.XXXXXX")"
result_file="$(mktemp "$cache_dir/usage.json.XXXXXX")"
trap 'rm -f -- "$capture_file" "$result_file"' EXIT

# Claude Code asks whether the directory it starts in is trusted, and waits for
# an answer before showing its prompt. Use a dedicated empty directory owned by
# the helper rather than a shared one such as /tmp, so that answering the dialog
# once covers nothing but this directory.
claude_work_dir="${CLAUDE_USAGE_WORK_DIR:-$cache_dir/workdir}"
if ! mkdir -p -- "$claude_work_dir"; then
	printf 'cannot create Claude usage working directory: %s\n' "$claude_work_dir" >&2
	exit 73
fi
chmod 700 -- "$claude_work_dir"
if ! cd -- "$claude_work_dir"; then
	printf 'cannot enter Claude usage working directory: %s\n' "$claude_work_dir" >&2
	exit 73
fi

if ! expect -f - "$capture_file" "$timeout_seconds" "$claude_bin" "$session_id" <<'EXPECT'
set capture_file [lindex $argv 0]
set timeout [lindex $argv 1]
set claude_bin [lindex $argv 2]
set session_id [lindex $argv 3]

log_user 0
log_file -noappend -a $capture_file
spawn -noecho $claude_bin --ax-screen-reader --session-id $session_id --name zebar-usage-monitor

expect {
	-re {(^|\r?\n)\$} {}
	timeout {
		puts stderr "timed out waiting for Claude Code input prompt"
		exit 2
	}
	eof {
		puts stderr "Claude Code exited before displaying its prompt"
		exit 2
	}
}

after 500
send -- "/usage\r"
expect {
	"Show plan usage" {
		after 200
		send -- "\r"
	}
	-re {Current.{0,24}session} {
		# Some Claude Code versions execute /usage immediately instead of
		# stopping on the slash-command suggestion.
	}
	timeout {
		puts stderr "timed out opening /usage"
		exit 2
	}
	eof {
		puts stderr "Claude Code exited while opening /usage"
		exit 2
	}
}

expect {
	-re {Current.{0,24}week} {}
	timeout {
		puts stderr "timed out waiting for /usage data"
		exit 2
	}
	eof {
		puts stderr "Claude Code exited before /usage data was displayed"
		exit 2
	}
}

# Give the usage request a moment to refresh. If it cannot refresh, Claude Code
# leaves the last-known values on screen; the parser reports that state in JSON.
after 5000
send -- "\033"
after 100
send -- "\003"
after 100
catch {close}
catch {wait}
log_file
EXPECT

then
	printf 'failed to refresh Claude usage; using cached data when available\n' >&2
	if [[ -s "$cache_file" ]]; then
		cat -- "$cache_file"
		exit 0
	fi
	exit 70
fi

if [[ -n "${CLAUDE_USAGE_CAPTURE_PATH:-}" ]]; then
	install -m 0600 -- "$capture_file" "$CLAUDE_USAGE_CAPTURE_PATH"
fi

if ! perl -MEncode=decode -MJSON::PP -MPOSIX=strftime,tzset -MScalar::Util=looks_like_number -MTime::Local=timelocal - "$capture_file" "$cache_file" "$samples_file" >"$result_file" <<'PERL'
use strict;
use warnings;

my ($capture_file, $cache_file, $samples_file) = @ARGV;
open my $capture, '<:raw', $capture_file
	or die "cannot read capture file: $!\n";
local $/;
my $text = decode('UTF-8', <$capture> // '', Encode::FB_DEFAULT);
close $capture;

# Remove OSC, CSI, and remaining short escape sequences emitted by the TUI.
$text =~ s/\e\][^\a]*(?:\a|\e\\)//gs;
$text =~ s/\e\[[0-?]*[ -\/]*[\@-~]//g;
$text =~ s/\e.//gs;
$text =~ tr/\x{00a0}/ /;
$text =~ s/\r/\n/g;
$text =~ s/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]//g;
$text =~ s/[ \t]+/ /g;
$text =~ s/\n+/\n/g;

sub extract_usage {
	my ($heading) = @_;
	my @matches;
	while (
		$text =~ /$heading\b.*?(\d+(?:\.\d+)?)%\s*used.*?Resets\s*([^\n]+?)\s*\(([^()\n]+)\)/gsi
	) {
		push @matches, [$1, $2, $3];
	}
	return $matches[-1];
}

my $session = extract_usage(qr/Current\s*session/i);
my $week = extract_usage(qr/Current\s*week(?:\s*\(all\s*models\))?/i);

if (!$session || !$week) {
	die "could not parse Current session and Current week from Claude /usage\n";
}

sub hour_24 {
	my ($hour, $ampm) = @_;
	$hour %= 12;
	$hour += 12 if lc($ampm) eq 'pm';
	return $hour;
}

sub iso_local {
	my ($epoch) = @_;
	my $value = strftime('%Y-%m-%dT%H:%M:%S%z', localtime($epoch));
	$value =~ s/([+-]\d{2})(\d{2})$/$1:$2/;
	return $value;
}

# A local time that does not exist (the hour a DST change skips) is not an
# error here, just a candidate to drop.
sub local_epoch {
	my ($minute, $hour, $mday, $month, $year) = @_;
	my $epoch = eval { timelocal(0, $minute, $hour, $mday, $month, $year) };
	return $epoch;
}

# Claude reports the session reset as a bare time of day and the week reset as
# a month and day: neither carries the date or year the reading belongs to, so
# the occurrence has to be inferred. Take the one nearest to now. A screen
# Claude has just refreshed always shows a reset that is still ahead, and the
# alternatives are a day or a year away, so this picks the same instant the
# arithmetic below used to. A `last_known` screen is what makes the direction
# matter: its reset may already have passed, and rolling that forward would
# publish a reset a whole day (session) or year (week) out.
sub nearest_occurrence {
	my ($now, @candidates) = @_;
	my $nearest;
	for my $candidate (@candidates) {
		next unless defined $candidate;
		$nearest = $candidate
			if !defined $nearest || abs($candidate - $now) < abs($nearest - $now);
	}
	return $nearest;
}

sub normalize_reset {
	my ($display, $timezone, $kind) = @_;
	local $ENV{TZ} = $timezone;
	tzset();
	my $now = time;
	my $epoch;

	if ($kind eq 'session' && $display =~ /^(\d{1,2})(?::(\d{2}))?(am|pm)$/i) {
		my $minute = defined $2 ? $2 : 0;
		my $hour = hour_24($1, $3);
		# Derived from each day's own calendar date rather than by adding 86400,
		# so a DST change does not shift the wall-clock time being matched.
		my @candidates = map {
			my @day = localtime($now + $_ * 86_400);
			local_epoch($minute, $hour, $day[3], $day[4], $day[5]);
		} (-1, 0, 1);
		$epoch = nearest_occurrence($now, @candidates);
	}
	elsif ($display =~ /^([A-Za-z]{3})\s*(\d{1,2}),\s*(\d{1,2})(?::(\d{2}))?(am|pm)$/i) {
		my %month;
		@month{qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec)} = 0 .. 11;
		# The session pattern has always been case-insensitive. Matching that
		# here costs a normalized lookup: an unknown month name must not reach
		# timelocal as undef.
		my $month = $month{ucfirst lc $1};
		my $minute = defined $4 ? $4 : 0;
		if (defined $month) {
			my $hour = hour_24($3, $5);
			my $year = (localtime($now))[5];
			$epoch = nearest_occurrence($now,
				map { local_epoch($minute, $hour, $2, $month, $_) }
					($year - 1, $year, $year + 1));
		}
	}

	return defined $epoch ? iso_local($epoch) : undef;
}

sub usage_object {
	my ($match, $kind) = @_;
	my ($percent, $reset_display, $timezone) = @$match;
	$reset_display =~ s/^\s+|\s+$//g;
	$timezone =~ s/^\s+|\s+$//g;
	$reset_display =~ s/^([A-Z][a-z]{2})(\d{1,2}),/$1 $2, /;
	my $normalized = normalize_reset($reset_display, $timezone, $kind);
	my %result = (
		used_percent => 0 + $percent,
		resets_at_display => $reset_display,
		timezone => $timezone,
	);
	$result{resets_at} = $normalized if defined $normalized;
	return \%result;
}

sub archive_sample {
	my ($path, $sample) = @_;
	return unless defined $path && length $path;

	# Give it its mode before anything writes, so the file is never briefly
	# readable at the process umask. The Codex helper does the same.
	unless (-e $path) {
		open my $created, '>>:raw', $path or return;
		close $created;
		chmod 0600, $path;
	}

	# A failed archive write must not cost the caller its usage reading.
	open my $log, '>>:raw', $path or return;
	print {$log} JSON::PP->new->canonical->encode($sample), "\n";
	close $log;
	return;
}

my $compact_text = $text;
$compact_text =~ s/\s+//g;
my ($age) = $compact_text =~ /Showinglast-knownusageasof(\d+[smhd])ago/i;
my $refresh_status = defined $age ? 'last_known' : 'not_reported';
my $generated_epoch = time;
my $generated_at = iso_local($generated_epoch);
my $session_usage = usage_object($session, 'session');
my $week_usage = usage_object($week, 'week');

my @history;
if (-s $cache_file) {
	my $previous = eval {
		open my $cache, '<:raw', $cache_file
			or die "cannot read previous cache: $!\n";
		local $/;
		my $decoded = JSON::PP->new->decode(<$cache> // '{}');
		close $cache;
		$decoded;
	};

	if (ref($previous) eq 'HASH' && ref($previous->{history}) eq 'ARRAY') {
		my $cutoff = $generated_epoch - 14 * 24 * 60 * 60;
		@history = grep {
			ref($_) eq 'HASH'
				&& looks_like_number($_->{recorded_at})
				&& $_->{recorded_at} >= $cutoff
				&& looks_like_number($_->{session_used_percent})
				&& looks_like_number($_->{week_used_percent})
		} @{$previous->{history}};
	}
}

# A read that produced a percentage but no reset time caught the screen
# half-drawn, and its percentage is not to be trusted: the one observed
# reported 0% for a week that was at 8% either side of it. The current values
# are still published - they self-correct on the next run - but a sample like
# that must not enter the history the graphs are derived from.
my $reset_times_parsed = defined $session_usage->{resets_at}
	&& defined $week_usage->{resets_at};

if ($refresh_status ne 'last_known' && !$reset_times_parsed) {
	# Left silent this would stop history collection for good if the wording or
	# date format ever changes: `generated_at` keeps moving, so the freshness
	# indicator stays green while the graphs empty out as the window rolls on.
	# cron pipes stderr to logger.
	printf {*STDERR} "claude usage: reset time did not parse; sample not recorded\n";
}

if ($refresh_status ne 'last_known' && $reset_times_parsed) {
	my %sample = (
		recorded_at => 0 + $generated_epoch,
		session_used_percent => 0 + $session_usage->{used_percent},
		week_used_percent => 0 + $week_usage->{used_percent},
	);
	$sample{session_resets_at} = $session_usage->{resets_at}
		if defined $session_usage->{resets_at};
	$sample{week_resets_at} = $week_usage->{resets_at}
		if defined $week_usage->{resets_at};

	if (@history && $generated_epoch - $history[-1]->{recorded_at} < 60) {
		$history[-1] = \%sample;
	}
	else {
		push @history, \%sample;
	}

	# Archived even when it replaced the previous cache entry: dropping it
	# would lose the newer reading for good. Readers dedupe on recorded_at.
	archive_sample($samples_file, \%sample);
}

my %output = (
	source => 'claude /usage',
	generated_at => $generated_at,
	refresh_status => $refresh_status,
	current_session => $session_usage,
	current_week => $week_usage,
	history => \@history,
);
$output{last_known_age} = $age if defined $age;

# Not pretty-printed: the widget re-reads this file every 60s, and indentation
# was a third of its size.
print JSON::PP->new->canonical->encode(\%output), "\n";
PERL

then
	printf 'failed to parse Claude usage; using cached data when available\n' >&2
	if [[ -s "$cache_file" ]]; then
		cat -- "$cache_file"
		exit 0
	fi
	exit 65
fi

chmod 600 -- "$result_file"
mv -f -- "$result_file" "$cache_file"
cat -- "$cache_file"
