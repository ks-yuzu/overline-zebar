#!/usr/bin/env bash

set -euo pipefail

timeout_seconds="${CLAUDE_USAGE_TIMEOUT:-45}"
if [[ ! "$timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
	printf 'CLAUDE_USAGE_TIMEOUT must be a positive integer\n' >&2
	exit 64
fi

cache_ttl_seconds="${CLAUDE_USAGE_CACHE_TTL:-300}"
if [[ ! "$cache_ttl_seconds" =~ ^[1-9][0-9]*$ ]]; then
	printf 'CLAUDE_USAGE_CACHE_TTL must be a positive integer\n' >&2
	exit 64
fi

session_id="${CLAUDE_USAGE_SESSION_ID:-ca1de000-0000-4000-8000-000000000001}"
if [[ ! "$session_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
	printf 'CLAUDE_USAGE_SESSION_ID must be a valid UUID\n' >&2
	exit 64
fi

force_refresh=false
cached_only=false
case "${1:-}" in
	'') ;;
	--force) force_refresh=true ;;
	--cached-only) cached_only=true ;;
	*)
		printf 'usage: %s [--force|--cached-only]\n' "$0" >&2
		exit 64
		;;
esac

cache_dir="${CLAUDE_USAGE_CACHE_DIR:-$HOME/.cache/claude-usage-json}"
cache_file="$cache_dir/usage.json"
# Append-only archive of raw samples. The cache prunes to 14 days on every
# write, so without this the older history is gone for good and no later
# rollup can be computed for it. The widget never reads this file.
samples_file="$cache_dir/samples.ndjson"
lock_file="$cache_dir/update.lock"
mkdir -p -- "$cache_dir"
chmod 700 -- "$cache_dir"

export CLAUDE_CODE_SKIP_PROMPT_HISTORY=1

if [[ "$cached_only" == true ]]; then
	if [[ ! -s "$cache_file" ]]; then
		printf 'Claude usage cache is not available yet\n' >&2
		exit 66
	fi
	cat -- "$cache_file"
	exit 0
fi

cache_is_fresh() {
	[[ -s "$cache_file" ]] || return 1
	local modified_at now
	modified_at="$(stat -c %Y -- "$cache_file")" || return 1
	now="$(date +%s)"
	((now - modified_at < cache_ttl_seconds))
}

if [[ "$force_refresh" == false ]] && cache_is_fresh; then
	cat -- "$cache_file"
	exit 0
fi

for command_name in expect perl flock; do
	if ! command -v "$command_name" >/dev/null 2>&1; then
		printf 'required command not found: %s\n' "$command_name" >&2
		if [[ -s "$cache_file" ]]; then
			cat -- "$cache_file"
			exit 0
		fi
		exit 69
	fi
done

# The main Zebar widget runs once per monitor. Serialize cache refreshes so only
# one of those processes opens Claude's interactive /usage screen.
exec 9>"$lock_file"
flock 9

if [[ "$force_refresh" == false ]] && cache_is_fresh; then
	cat -- "$cache_file"
	exit 0
fi

default_claude_bin="$HOME/bin/claude"
if [[ ! -x "$default_claude_bin" ]]; then
	default_claude_bin="$(command -v claude || true)"
fi
claude_bin="${CLAUDE_USAGE_CLAUDE_BIN:-$default_claude_bin}"
if [[ -z "$claude_bin" || ! -x "$claude_bin" ]]; then
	printf 'Claude executable not found; set CLAUDE_USAGE_CLAUDE_BIN\n' >&2
	if [[ -s "$cache_file" ]]; then
		cat -- "$cache_file"
		exit 0
	fi
	exit 69
fi

capture_file="$(mktemp "${TMPDIR:-/tmp}/claude-usage.XXXXXX")"
result_file="$(mktemp "$cache_dir/usage.json.XXXXXX")"
trap 'rm -f -- "$capture_file" "$result_file"' EXIT

# Claude Code asks whether the directory it starts in is trusted, and waits for
# an answer before showing its prompt. Use a dedicated empty directory owned by
# the helper rather than a shared one such as /tmp, so that answering the dialog
# once covers nothing but this directory.
claude_work_dir="${CLAUDE_USAGE_WORK_DIR:-$cache_dir/workdir}"
if ! mkdir -p -- "$claude_work_dir"; then
	printf 'cannot create Claude usage working directory: %s\n' "$claude_work_dir" >&2
	exit 73
fi
chmod 700 -- "$claude_work_dir"
if ! cd -- "$claude_work_dir"; then
	printf 'cannot enter Claude usage working directory: %s\n' "$claude_work_dir" >&2
	exit 73
fi

if ! expect -f - "$capture_file" "$timeout_seconds" "$claude_bin" "$session_id" <<'EXPECT'
set capture_file [lindex $argv 0]
set timeout [lindex $argv 1]
set claude_bin [lindex $argv 2]
set session_id [lindex $argv 3]

log_user 0
log_file -noappend -a $capture_file
spawn -noecho $claude_bin --ax-screen-reader --session-id $session_id --name zebar-usage-monitor

expect {
	-re {(^|\r?\n)\$} {}
	timeout {
		puts stderr "timed out waiting for Claude Code input prompt"
		exit 2
	}
	eof {
		puts stderr "Claude Code exited before displaying its prompt"
		exit 2
	}
}

after 500
send -- "/usage\r"
expect {
	"Show plan usage" {
		after 200
		send -- "\r"
	}
	-re {Current.{0,24}session} {
		# Some Claude Code versions execute /usage immediately instead of
		# stopping on the slash-command suggestion.
	}
	timeout {
		puts stderr "timed out opening /usage"
		exit 2
	}
	eof {
		puts stderr "Claude Code exited while opening /usage"
		exit 2
	}
}

expect {
	-re {Current.{0,24}week} {}
	timeout {
		puts stderr "timed out waiting for /usage data"
		exit 2
	}
	eof {
		puts stderr "Claude Code exited before /usage data was displayed"
		exit 2
	}
}

# Give the usage request a moment to refresh. If it cannot refresh, Claude Code
# leaves the last-known values on screen; the parser reports that state in JSON.
after 5000
send -- "\033"
after 100
send -- "\003"
after 100
catch {close}
catch {wait}
log_file
EXPECT

then
	printf 'failed to refresh Claude usage; using cached data when available\n' >&2
	if [[ -s "$cache_file" ]]; then
		cat -- "$cache_file"
		exit 0
	fi
	exit 70
fi

if [[ -n "${CLAUDE_USAGE_CAPTURE_PATH:-}" ]]; then
	install -m 0600 -- "$capture_file" "$CLAUDE_USAGE_CAPTURE_PATH"
fi

if ! perl -MEncode=decode -MJSON::PP -MPOSIX=strftime,tzset -MScalar::Util=looks_like_number -MTime::Local=timelocal - "$capture_file" "$cache_file" "$samples_file" >"$result_file" <<'PERL'
use strict;
use warnings;

my ($capture_file, $cache_file, $samples_file) = @ARGV;
open my $capture, '<:raw', $capture_file
	or die "cannot read capture file: $!\n";
local $/;
my $raw_screen = decode('UTF-8', <$capture> // '', Encode::FB_DEFAULT);
close $capture;

# Remove OSC, CSI, and remaining short escape sequences emitted by the TUI.
sub normalize_screen {
	my ($screen) = @_;
	$screen =~ s/\e\][^\a]*(?:\a|\e\\)//gs;
	$screen =~ s/\e\[[0-?]*[ -\/]*[\@-~]//g;
	$screen =~ s/\e.//gs;
	$screen =~ tr/\x{00a0}/ /;
	$screen =~ s/\r/\n/g;
	$screen =~ s/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]//g;
	$screen =~ s/[ \t]+/ /g;
	$screen =~ s/\n+/\n/g;
	return $screen;
}

# The panel gives each window a heading of its own: `Current session`, then
# `Current week (all models)`, and on a plan that caps one model separately a
# further `Current week (<model>)`. Cut the screen at those headings so a
# window's numbers are read only from its own stretch.
#
# A single expression per window cannot do this. `Current week` followed by
# `.*?% used` scans past the end of its own section, so the moment a second
# weekly heading appears the all-models window reads the per-model figures -
# a wrong value written under a name that has been right for months.
sub scan_sections {
	my ($screen) = @_;
	my @sections;
	while ($screen =~ /Current\s*(session|week)\b\s*(?:\(\s*([^()\n]{1,40}?)\s*\))?/gi) {
		push @sections, {
			kind => lc $1,
			label => $2,
			heading_at => $-[0],
			body_at => $+[0],
		};
	}
	for my $i (0 .. $#sections) {
		my $body_end = $i < $#sections ? $sections[$i + 1]{heading_at} : length $screen;
		$sections[$i]{body} = substr $screen, $sections[$i]{body_at},
			$body_end - $sections[$i]{body_at};
	}
	return @sections;
}

# The gauge prints the figure twice - `31% 31% used` - so the percentage is
# taken from the one the word follows, not the first on the line.
sub reading_from {
	my ($body) = @_;
	return undef unless $body =~ /(\d+(?:\.\d+)?)%\s*used/;
	my $percent = $1;
	return undef unless $body =~ /Resets\s*([^\n]+?)\s*\(([^()\n]+)\)/;
	return [$percent, $1, $2];
}

# A heading with no parenthetical is the all-models week: the wording was bare
# before the per-model windows existed, and some versions still print it that
# way. Only a parenthetical that names something else marks a per-model window.
sub is_all_models {
	my ($label) = @_;
	return 1 unless defined $label;
	return $label =~ /^all\s*models$/i ? 1 : 0;
}

sub read_windows {
	my ($screen) = @_;
	my ($session, $week, %model);

	for my $section (scan_sections($screen)) {
		my $reading = reading_from($section->{body})
			or next;
		my $window = { label => $section->{label}, reading => $reading };

		# The capture holds every redraw of the panel, and the headings of a
		# half-drawn one carry no numbers yet, so each window keeps the last
		# render that was complete rather than the last heading seen.
		if ($section->{kind} eq 'session') {
			$session = $window;
		}
		elsif (is_all_models($section->{label})) {
			$week = $window;
		}
		else {
			$model{lc $section->{label}} = $window;
		}
	}

	my @model_labels = sort keys %model;
	my $model_week;
	if (@model_labels == 1) {
		$model_week = $model{ $model_labels[0] };
	}
	elsif (@model_labels > 1) {
		# Only a tie-break between windows already found by their shape, never
		# the test for what a per-model window is. Naming the model there would
		# make a renamed one read as a plan that has no such window at all.
		my @fable = grep { /fable/ } @model_labels;
		$model_week = $model{ $fable[0] } if @fable == 1;
	}

	return {
		session => $session,
		week => $week,
		model_week => $model_week,
		model_labels => \@model_labels,
	};
}

sub hour_24 {
	my ($hour, $ampm) = @_;
	$hour %= 12;
	$hour += 12 if lc($ampm) eq 'pm';
	return $hour;
}

sub iso_local {
	my ($epoch) = @_;
	my $value = strftime('%Y-%m-%dT%H:%M:%S%z', localtime($epoch));
	$value =~ s/([+-]\d{2})(\d{2})$/$1:$2/;
	return $value;
}

# timelocal croaks on a date that does not exist - Feb 29 of a non-leap year,
# reachable because the neighbouring years are candidates too - and that would
# take the whole reading down, so an impossible date becomes a dropped
# candidate instead. A time that a DST change skips is not this case: timelocal
# returns the shifted instant for those, and the candidate is kept.
sub local_epoch {
	my ($minute, $hour, $mday, $month, $year) = @_;
	my $epoch = eval { timelocal(0, $minute, $hour, $mday, $month, $year) };
	return $epoch;
}

# Each window is a fixed length, so a reset cannot be further from now than
# that in either direction: ahead of it the window would not have started, and
# behind it the screen would be more than a whole window stale. Displayed to
# the minute, a reset can read a little beyond its own window, hence the grace.
#
# These lengths decide whether a reset is published at all, so a provider-side
# change to a window would stop `resets_at` and history collection with only a
# stderr line per run to say so. The widgets carry the same two lengths as
# SESSION_WINDOW_SECONDS/WEEK_WINDOW_SECONDS in
# widgets/main/src/components/claudeUsage/ClaudeUsage.tsx and
# widgets/ai-usage-details/src/App.tsx: change all three together.
my %window_seconds = (
	session => 5 * 60 * 60,
	week => 7 * 24 * 60 * 60,
);
my $window_grace_seconds = 600;

# Claude reports the session reset as a bare time of day and the week reset as
# a month and day: neither carries the date or year the reading belongs to, so
# the occurrence has to be inferred. Take the one nearest to now, of those the
# window length allows. A screen Claude has just refreshed always shows a reset
# that is still ahead, and the alternatives are a day or a year away, so this
# picks the same instant the arithmetic used to. A `last_known` screen is what
# makes the rest matter: its reset may already have passed, and rolling that
# forward would publish a reset a whole day (session) or year (week) out. Once
# such a screen is more than a window stale, no candidate is credible - the
# nearest would be the next window's, which has not started - so nothing is
# published and the widget falls back to Claude's own label without a countdown.
sub nearest_occurrence {
	my ($now, $limit, @candidates) = @_;
	my $nearest;
	for my $candidate (@candidates) {
		next unless defined $candidate;
		next if defined $limit && abs($candidate - $now) > $limit;
		$nearest = $candidate
			if !defined $nearest || abs($candidate - $now) < abs($nearest - $now);
	}
	return $nearest;
}

sub normalize_reset {
	my ($display, $timezone, $kind) = @_;
	local $ENV{TZ} = $timezone;
	tzset();
	my $now = time;
	my $epoch;
	# The week label is also what a session reset falls back to when it carries
	# a date, so the limit follows the kind rather than the pattern that matched.
	my $limit = defined $window_seconds{$kind}
		? $window_seconds{$kind} + $window_grace_seconds
		: undef;

	if ($kind eq 'session' && $display =~ /^(\d{1,2})(?::(\d{2}))?(am|pm)$/i) {
		my $minute = defined $2 ? $2 : 0;
		my $hour = hour_24($1, $3);
		# Each day contributes its own calendar date, and the wall-clock time is
		# rebuilt from those parts, so a DST change shifts neither. The walk to
		# the neighbouring days starts from local noon: the day before a
		# spring-forward is 23 hours long, so stepping 86400 seconds from a time
		# late in it lands two dates later and skips the day the reset is on.
		# Noon cannot cross a date boundary for the hour a transition moves.
		my @today = localtime($now);
		my $noon = local_epoch(0, 12, $today[3], $today[4], $today[5]);
		$noon = $now unless defined $noon;
		my @candidates = map {
			my @day = localtime($noon + $_ * 86_400);
			local_epoch($minute, $hour, $day[3], $day[4], $day[5]);
		} (-1, 0, 1);
		$epoch = nearest_occurrence($now, $limit, @candidates);
	}
	elsif ($display =~ /^([A-Za-z]{3})\s*(\d{1,2}),\s*(\d{1,2})(?::(\d{2}))?(am|pm)$/i) {
		my %month;
		@month{qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec)} = 0 .. 11;
		# The session pattern has always been case-insensitive. Matching that
		# here costs a normalized lookup: an unknown month name must not reach
		# timelocal as undef.
		my $month = $month{ucfirst lc $1};
		my $minute = defined $4 ? $4 : 0;
		if (defined $month) {
			my $hour = hour_24($3, $5);
			my $year = (localtime($now))[5];
			$epoch = nearest_occurrence($now, $limit,
				map { local_epoch($minute, $hour, $2, $month, $_) }
					($year - 1, $year, $year + 1));
		}
	}

	return defined $epoch ? iso_local($epoch) : undef;
}

sub usage_object {
	my ($match, $kind) = @_;
	my ($percent, $reset_display, $timezone) = @$match;
	$reset_display =~ s/^\s+|\s+$//g;
	$timezone =~ s/^\s+|\s+$//g;
	$reset_display =~ s/^([A-Z][a-z]{2})(\d{1,2}),/$1 $2, /;
	my $normalized = normalize_reset($reset_display, $timezone, $kind);
	my %result = (
		used_percent => 0 + $percent,
		resets_at_display => $reset_display,
		timezone => $timezone,
	);
	$result{resets_at} = $normalized if defined $normalized;
	return \%result;
}

sub archive_sample {
	my ($path, $sample) = @_;
	return unless defined $path && length $path;

	# Give it its mode before anything writes, so the file is never briefly
	# readable at the process umask. The Codex helper does the same.
	unless (-e $path) {
		open my $created, '>>:raw', $path or return;
		close $created;
		chmod 0600, $path;
	}

	# A failed archive write must not cost the caller its usage reading.
	open my $log, '>>:raw', $path or return;
	print {$log} JSON::PP->new->canonical->encode($sample), "\n";
	close $log;
	return;
}

my $text = normalize_screen($raw_screen);
my $windows = read_windows($text);
my $session = $windows->{session};
my $week = $windows->{week};
my $model_week = $windows->{model_week};

if (!$session || !$week) {
	die "could not parse Current session and Current week from Claude /usage\n";
}

# Two of them and no way to tell which the widget should draw. Recording either
# would put one model's consumption under the other's name for as long as the
# screen stays that way, so the window is left out and the other two go on.
if (!$model_week && @{ $windows->{model_labels} } > 1) {
	printf {*STDERR} "claude usage: %d per-model weekly windows on screen (%s); none recorded\n",
		scalar @{ $windows->{model_labels} },
		join ', ', @{ $windows->{model_labels} };
}

my $compact_text = $text;
$compact_text =~ s/\s+//g;
my ($age) = $compact_text =~ /Showinglast-knownusageasof(\d+[smhd])ago/i;
my $refresh_status = defined $age ? 'last_known' : 'not_reported';
my $generated_epoch = time;
my $generated_at = iso_local($generated_epoch);
my $session_usage = usage_object($session->{reading}, 'session');
my $week_usage = usage_object($week->{reading}, 'week');

# A per-model week is a week: same length, so the same rule decides which
# occurrence of the reset label is meant.
my $model_week_usage;
if ($model_week) {
	$model_week_usage = usage_object($model_week->{reading}, 'week');
	$model_week_usage->{label} = $model_week->{label};
}

my @history;
if (-s $cache_file) {
	my $previous = eval {
		open my $cache, '<:raw', $cache_file
			or die "cannot read previous cache: $!\n";
		local $/;
		my $decoded = JSON::PP->new->decode(<$cache> // '{}');
		close $cache;
		$decoded;
	};

	if (ref($previous) eq 'HASH' && ref($previous->{history}) eq 'ARRAY') {
		my $cutoff = $generated_epoch - 14 * 24 * 60 * 60;
		# The same rule the write below applies: a reading that lost a reset
		# time was caught mid-draw and its percentages cannot be trusted. Read
		# on every write, so this also purges samples a helper without that
		# rule left behind - they would otherwise poison the graphs for 14 days.
		#
		# Deliberately coarser than the widget, which drops a sample only from
		# the period whose reset it lacks. What is in doubt here is the reading,
		# not its placement: the one observed reported 0% for a week that was at
		# 8% either side, and the other half of that same screen is no more
		# trustworthy. The widget's per-period rule is for a cache this version
		# has not rewritten yet, not a second opinion on which samples are good.
		@history = grep {
			ref($_) eq 'HASH'
				&& looks_like_number($_->{recorded_at})
				&& $_->{recorded_at} >= $cutoff
				&& looks_like_number($_->{session_used_percent})
				&& looks_like_number($_->{week_used_percent})
				&& defined $_->{session_resets_at}
				&& defined $_->{week_resets_at}
		} @{$previous->{history}};

		# The per-model window is carried as a complete triple or not at all. A
		# percentage with no reset cannot be placed in a window, and one with no
		# label cannot be told apart from the next model's, so a sample that has
		# part of the triple loses that part and keeps the two windows that were
		# always there. Applied on every write, so a cache an earlier helper left
		# half-written is cleaned rather than drawn for the next 14 days.
		for my $sample (@history) {
			next if looks_like_number($sample->{week_model_used_percent})
				&& defined $sample->{week_model_resets_at}
				&& defined $sample->{week_model_label};
			delete @{$sample}{
				qw(week_model_used_percent week_model_resets_at week_model_label)
			};
		}
	}
}

# A read that produced a percentage but no reset time caught the screen
# half-drawn, and its percentage is not to be trusted: the one observed
# reported 0% for a week that was at 8% either side of it. The current values
# are still published - they self-correct on the next run - but a sample like
# that must not enter the history the graphs are derived from.
my $reset_times_parsed = defined $session_usage->{resets_at}
	&& defined $week_usage->{resets_at};

if ($refresh_status ne 'last_known'
	&& $model_week_usage
	&& !defined $model_week_usage->{resets_at}) {
	printf {*STDERR}
		"claude usage: per-model weekly reset time did not parse; that window not recorded\n";
}

if ($refresh_status ne 'last_known' && !$reset_times_parsed) {
	# Left silent this would stop history collection for good if the wording or
	# date format ever changes: `generated_at` keeps moving, so the freshness
	# indicator stays green while the graphs empty out as the window rolls on.
	# cron pipes stderr to logger.
	printf {*STDERR} "claude usage: reset time did not parse; sample not recorded\n";
}

if ($refresh_status ne 'last_known' && $reset_times_parsed) {
	my %sample = (
		recorded_at => 0 + $generated_epoch,
		session_used_percent => 0 + $session_usage->{used_percent},
		week_used_percent => 0 + $week_usage->{used_percent},
	);
	$sample{session_resets_at} = $session_usage->{resets_at}
		if defined $session_usage->{resets_at};
	$sample{week_resets_at} = $week_usage->{resets_at}
		if defined $week_usage->{resets_at};

	# The per-model window rides along; it does not gate the sample the way the
	# other two do. Its heading and its reset wording are the newest part of the
	# screen and the likeliest to change, and letting a change there stop the
	# sample would empty the graphs for the two windows that still parsed.
	if ($model_week_usage && defined $model_week_usage->{resets_at}) {
		$sample{week_model_used_percent} = 0 + $model_week_usage->{used_percent};
		$sample{week_model_resets_at} = $model_week_usage->{resets_at};
		$sample{week_model_label} = $model_week_usage->{label};
	}

	if (@history && $generated_epoch - $history[-1]->{recorded_at} < 60) {
		$history[-1] = \%sample;
	}
	else {
		push @history, \%sample;
	}

	# Archived even when it replaced the previous cache entry: dropping it
	# would lose the newer reading for good. Readers dedupe on recorded_at.
	archive_sample($samples_file, \%sample);
}

my %output = (
	source => 'claude /usage',
	generated_at => $generated_at,
	refresh_status => $refresh_status,
	current_session => $session_usage,
	current_week => $week_usage,
	history => \@history,
);
$output{current_week_model} = $model_week_usage if $model_week_usage;
$output{last_known_age} = $age if defined $age;

# Not pretty-printed: the widget re-reads this file every 60s, and indentation
# was a third of its size.
print JSON::PP->new->canonical->encode(\%output), "\n";
PERL

then
	printf 'failed to parse Claude usage; using cached data when available\n' >&2
	if [[ -s "$cache_file" ]]; then
		cat -- "$cache_file"
		exit 0
	fi
	exit 65
fi

chmod 600 -- "$result_file"
