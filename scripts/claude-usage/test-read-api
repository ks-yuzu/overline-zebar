#!/usr/bin/env perl

# Checks how claude-usage-json turns the usage endpoint's answer into windows.
#
# The endpoint names each window rather than printing a heading for it, so
# there is nothing to classify - but a reading that comes back wrong is still
# a plausible percentage under a field name, invisible in the JSON and visible
# only as a chip that has been reporting the wrong quota. Run from anywhere:
#
#   perl scripts/claude-usage/test-read-api

use strict;
use warnings;
use File::Basename qw(dirname);
use JSON::PP;
use Scalar::Util qw(looks_like_number);
use POSIX qw(strftime);
use Time::Local qw(timegm timelocal);
use File::Temp qw(tempfile);

my $helper = dirname(__FILE__) . '/claude-usage-json';
open my $fh, '<', $helper or die "cannot read $helper: $!\n";
my $source = do { local $/; <$fh> };
close $fh;

my ($subs) = $source =~ /^(sub parse_iso8601\b.*?)^sub local_epoch\b/ms;
die "could not find the endpoint subroutines in $helper\n" unless $subs;
my ($reader) = $source =~ /^(sub read_api_windows\b.*?\n\}\n)/ms;
die "could not find read_api_windows in $helper\n" unless $reader;
eval "$subs $reader 1" or die "could not load the endpoint subroutines: $@";

sub limit {
	my (%field) = @_;
	return {
		kind => $field{kind},
		percent => $field{percent},
		resets_at => $field{resets_at} // '2026-09-07T00:00:00.146172+00:00',
		scope => $field{model}
			? { model => { id => undef, display_name => $field{model} } }
			: undef,
	};
}

sub read_or_undef {
	my ($payload) = @_;
	my $windows = eval { read_api_windows(encode_json($payload)) };
	return $windows;
}

my @cases = (
	{
		name => 'the three windows the panel shows',
		payload => {
			limits => [
				limit(kind => 'session', percent => 7),
				limit(kind => 'weekly_all', percent => 44),
				limit(kind => 'weekly_scoped', percent => 12, model => 'Fable'),
			],
		},
		session => 7,
		week => 44,
		model => 12,
		model_label => 'Fable',
	},
	{
		# The plans without a per-model quota answer with the key present and
		# null. Read as a window it would draw as one sitting at zero.
		name => 'a scoped window that is not there',
		payload => {
			limits => [
				limit(kind => 'session', percent => 7),
				limit(kind => 'weekly_all', percent => 44),
			],
		},
		session => 7,
		week => 44,
		model => undef,
	},
	{
		# The same rule the panel reading uses. Nothing in the answer says
		# which of them the widget is for.
		name => 'two scoped windows are neither of them recorded',
		payload => {
			limits => [
				limit(kind => 'session', percent => 7),
				limit(kind => 'weekly_all', percent => 44),
				limit(kind => 'weekly_scoped', percent => 12, model => 'Fable'),
				limit(kind => 'weekly_scoped', percent => 30, model => 'Opus'),
			],
		},
		session => 7,
		week => 44,
		model => undef,
	},
	{
		# A window whose reset will not parse cannot be placed on an axis, and
		# a percentage with nowhere to sit is worse than no window at all.
		name => 'a window with an unreadable reset is left out',
		payload => {
			limits => [
				limit(kind => 'session', percent => 7),
				limit(kind => 'weekly_all', percent => 44),
				limit(
					kind => 'weekly_scoped',
					percent => 12,
					model => 'Fable',
					resets_at => 'next Tuesday'
				),
			],
		},
		session => 7,
		week => 44,
		model => undef,
	},
	{
		# `kind` is what says which window this is. Matching on the scope, or
		# on position, would make an added window take another one's place.
		name => 'an unknown kind is not mistaken for a window',
		payload => {
			limits => [
				limit(kind => 'session', percent => 7),
				limit(kind => 'weekly_all', percent => 44),
				limit(kind => 'monthly_all', percent => 90),
			],
		},
		session => 7,
		week => 44,
		model => undef,
	},
	{
		name => 'a scoped window with no model name is left out',
		payload => {
			limits => [
				limit(kind => 'session', percent => 7),
				limit(kind => 'weekly_all', percent => 44),
				limit(kind => 'weekly_scoped', percent => 12),
			],
		},
		session => 7,
		week => 44,
		model => undef,
	},
);

my $failures = 0;
for my $case (@cases) {
	my $windows = read_or_undef($case->{payload});
	my @problems;

	if (!$windows) {
		push @problems, "died: $@";
	}
	else {
		for my $field (qw(session week model)) {
			my $key = $field eq 'model' ? 'week_model' : $field;
			my $got = $windows->{$key} ? $windows->{$key}{used_percent} : undef;
			my $want = $case->{$field};
			next if !defined $got && !defined $want;
			next if defined $got && defined $want && $got == $want;
			push @problems, sprintf '%s=%s expected=%s', $field,
				defined $got ? $got : 'undef',
				defined $want ? $want : 'undef';
		}
		my $got_label = $windows->{week_model} ? $windows->{week_model}{label} : undef;
		my $want_label = $case->{model_label};
		unless ((!defined $got_label && !defined $want_label)
			|| (defined $got_label && defined $want_label && $got_label eq $want_label)) {
			push @problems, sprintf 'label=%s expected=%s',
				defined $got_label ? $got_label : 'undef',
				defined $want_label ? $want_label : 'undef';
		}
	}

	$failures++ if @problems;
	printf "%s - %s\n", @problems ? 'not ok' : 'ok', $case->{name};
	printf "    %s\n", join '; ', @problems if @problems;
}

# The reset arrives as an instant. Read with the offset ignored it lands hours
# away, and the chip counts down to the wrong hour while the JSON looks fine.
my @instants = (
	['2026-09-07T00:00:00.146172+00:00', 1788739200],
	['2026-09-07T00:00:00Z', 1788739200],
	['2026-09-07T09:00:00+09:00', 1788739200],
	['2026-09-06T19:00:00-05:00', 1788739200],
	['next Tuesday', undef],
	['2026-09-07T00:00:00', undef],
);
for my $instant (@instants) {
	my ($text, $want) = @$instant;
	my $got = parse_iso8601($text);
	my $ok = (!defined $got && !defined $want)
		|| (defined $got && defined $want && $got == $want);
	$failures++ unless $ok;
	printf "%s - reset instant %s\n", $ok ? 'ok' : 'not ok', $text;
	printf "    got=%s expected=%s\n",
		defined $got ? $got : 'undef', defined $want ? $want : 'undef'
		unless $ok;
}

# The helper decides whether the endpoint answered with a reading before it
# runs the reader, and that decision is a second copy of this rule, in the bash
# half. Looser there and a reset the reader will not take passes as a reading:
# the reader drops every window and dies, and the run ends as a parse failure
# with the panel - the thing that decision exists to reach - never opened. That
# is how it broke once, so the two are held side by side here.
#
# The precheck is lifted out and run, not written out again. Rewriting it here
# is what let an earlier version of this file stay green while the rule it was
# meant to hold was deleted from the helper.
# Anchored on the module list, so a reindent cannot make it capture the
# neighbouring program that reads the token instead - the `/limits/` guard
# below would not notice that, since the two would be concatenated.
my ($precheck) = $source =~ /-MTime::Local=timegm -0777 -ne '(.*?)\n\t' -- /s;
die "could not lift the payload precheck out of $helper\n"
	unless defined $precheck && $precheck =~ /limits/;

sub precheck_takes {
	my ($reset) = @_;
	my $payload = JSON::PP->new->canonical->encode({
		limits => [
			{ kind => 'session', percent => 1, resets_at => $reset },
			{ kind => 'weekly_all', percent => 1, resets_at => $reset },
		],
	});
	my ($fh, $path) = tempfile(
		'claude-usage-precheck-XXXXXX',
		DIR => ($ENV{TMPDIR} // '/tmp'),
		SUFFIX => '.json',
		UNLINK => 0,
	);
	print {$fh} $payload;
	close $fh;
	my $status = system('perl', '-MJSON::PP', '-MScalar::Util=looks_like_number',
		'-MTime::Local=timegm', '-0777', '-ne', $precheck, '--', $path);
	unlink $path;
	return $status == 0 ? 1 : 0;
}

my @resets = (
	'2026-09-07T00:00:00.146172+00:00',
	'2026-09-07T00:00:00Z',
	'2026-09-07T09:00:00+09:00',
	'2026-09-07T09:00:00+0900',
	'2026-09-07T00:00:00',
	'2026-09-07T00:00:00+09:00[Asia/Tokyo]',
	'2026-09-07T00:00:00+09:00:00',
	'2026-13-45T00:00:00Z',
	'2026-02-30T00:00:00Z',
	'next Tuesday',
	'',
);
for my $reset (@resets) {
	my $taken = defined parse_iso8601($reset) ? 1 : 0;
	my $passed = precheck_takes($reset);
	my $ok = $taken == $passed;
	$failures++ unless $ok;
	printf "%s - precheck agrees with the reader on %s\n",
		$ok ? 'ok' : 'not ok', $reset eq '' ? '(empty)' : $reset;
	printf "    precheck=%s reader=%s\n", $passed ? 'takes' : 'refuses',
		$taken ? 'takes' : 'refuses'
		unless $ok;
}

my $total = @cases + @instants + @resets;
printf "\n%d of %d cases failed\n", $failures, $total if $failures;
printf "\nall %d cases pass\n", $total unless $failures;
exit($failures ? 1 : 0);
