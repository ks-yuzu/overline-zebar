#!/usr/bin/env perl

# Checks how claude-usage-json decides which numbers on the /usage screen
# belong to which window.
#
# The screen names its windows `Current session`, `Current week (all models)`
# and, on a plan that caps one model separately, `Current week (<model>)`.
# Getting the split wrong is invisible in the JSON - the value is still a
# plausible percentage - and shows up only as a chip and a graph that have been
# reporting one window's consumption under another window's name.
#
# Labels are compared as the screen spells them. The helper keys per-model
# windows on the label verbatim, so two spellings are two windows and neither
# is recorded - folding case here would hide that.
#
# The subroutines are read out of the helper rather than duplicated here: this
# has to break when the helper changes, not track it. Run from anywhere:
#
#   perl scripts/claude-usage/test-read-windows

use strict;
use warnings;
use File::Basename qw(dirname);

my $helper = dirname(__FILE__) . '/claude-usage-json';
open my $fh, '<', $helper or die "cannot read $helper: $!\n";
my $source = do { local $/; <$fh> };
close $fh;

my ($subs) = $source =~ /^(sub normalize_screen\b.*?)^sub hour_24\b/ms;
die "could not find the screen subroutines in $helper\n" unless $subs;
eval "$subs 1" or die "could not load the screen subroutines: $@";

# The capture is a terminal log, so the fixtures carry what a terminal log
# carries: carriage returns, erase-line sequences, and the non-breaking spaces
# the panel pads with.
my $esc = "\e[2K";

my @cases = (
	{
		name => 'plan with no per-model window',
		screen => join("\r\n",
			'Current session',
			'23% 23% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week (all models)',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
			'+50% weekly limits promo through Sep 13',
			"What's contributing to your limits usage?",
		),
		session => 23,
		week => 31,
		model => undef,
		labels => '',
	},
	{
		# The one this window was added for. A single expression that scans
		# from `Current week` to the next `% used` walks straight past the
		# all-models figures into these, and publishes 68 as the weekly total.
		name => 'per-model week does not take over the all-models week',
		screen => join("\r\n",
			'Current session',
			'23% 23% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week (all models)',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
			'Current week (Fable)',
			'68% 68% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
		),
		session => 23,
		week => 31,
		model => 68,
		model_label => 'Fable',
		labels => 'Fable',
	},
	{
		name => 'bracketed text below a bare heading is body, not a label',
		screen => join("\r\n",
			'Current session',
			'23% 23% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week',
			'(resets weekly)',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
		),
		session => 23,
		week => 31,
		model => undef,
		labels => '',
	},
	{
		# The expression this replaced was case-insensitive, and dropping that
		# would turn a capitalisation change into a helper that dies on every
		# run and serves the same frozen cache for good.
		name => 'panel rendered with different capitalisation',
		screen => join("\r\n",
			'Current session',
			'23% 23% Used',
			'resets 11:10am (Asia/Tokyo)',
			'CURRENT WEEK (ALL MODELS)',
			'31% 31% USED',
			'RESETS Sep 7, 9am (Asia/Tokyo)',
		),
		session => 23,
		week => 31,
		model => undef,
		labels => '',
	},
	{
		# The wording before the per-model windows existed. It has to stay the
		# all-models week, or every plan without one loses its weekly figure.
		name => 'weekly heading with no parenthetical',
		screen => join("\r\n",
			'Current session',
			'23% 23% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
		),
		session => 23,
		week => 31,
		model => undef,
		labels => '',
	},
	{
		name => 'headings drawn before their numbers arrive',
		screen => join("\r\n",
			'Current session',
			'Current week (all models)',
			$esc . 'Current session',
			'23% 23% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week (all models)',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
		),
		session => 23,
		week => 31,
		model => undef,
		labels => '',
	},
	{
		# The capture ends mid-redraw far more often than not: the helper cuts
