		name => 'redraw starts again after a complete panel',
		screen => join("\r\n",
			'Current session',
			'23% 23% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week (all models)',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
			$esc . 'Current session',
			'Current week (all models)',
		),
		session => 23,
		week => 31,
		model => undef,
		labels => '',
	},
	{
		# Observed on a real screen: the gauge had not caught up with the
		# figure beside it. The word is what says which one is the reading.
		name => 'gauge and figure disagree mid-update',
		screen => join("\r\n",
			'Current session',
			'29% 28% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week (all models)',
			'32% 32% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
		),
		session => 28,
		week => 32,
		model => undef,
		labels => '',
	},
	{
		# Nothing on the screen says which one the widget is for, and writing
		# either would put one model's consumption under the other's name.
		# The count is the whole rule: no preference for any model name, so
		# that a plan gaining a second window cannot silently switch which
		# model the series holds.
		name => 'two per-model windows on one screen',
		screen => join("\r\n",
			'Current session',
			'23% 23% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week (all models)',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
			'Current week (Opus)',
			'40% 40% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
			'Current week (Sonnet)',
			'20% 20% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
		),
		session => 23,
		week => 31,
		model => undef,
		labels => 'Opus, Sonnet',
	},
	{
		# `(all models)` is matched exactly. Read as "contains those words" a
		# model named in a way that mentions them is taken for the total, and
		# its consumption is published as the weekly figure - a wrong number
		# under a field name that has been right for months.
		name => 'model name that mentions all models',
		screen => join("\r\n",
			'Current session',
			'5% 5% used',
			'Resets 9:10pm (Asia/Tokyo)',
			'Current week (all models)',
			'38% 38% used',
			'Resets Sep 7, 8:59am (Asia/Tokyo)',
			'Current week (Fable, not all models)',
			'7% 7% used',
			'Resets Sep 7, 8:59am (Asia/Tokyo)',
		),
		session => 5,
		week => 38,
		model => 7,
		model_label => 'Fable, not all models',
		labels => 'Fable, not all models',
	},
	{
		# The bracket has to close on the line it opened on. Allowed to run to
		# the next line it swallows the body, and the window it invents is
		# recorded under a name that was never a model.
		name => 'bracket opens on the heading and closes below',
		screen => join("\r\n",
			'Current session',
			'5% 5% used',
			'Resets 9:10pm (Asia/Tokyo)',
			'Current week (all models)',
			'38% 38% used',
			'Resets Sep 7, 8:59am (Asia/Tokyo)',
			'Current week (',
			'resets weekly)',
			'7% 7% used',
			'Resets Sep 7, 8:59am (Asia/Tokyo)',
		),
		session => 5,
		week => 38,
		model => undef,
		labels => '',
	},
	{
		# `Current week` with nothing after it means the total, so a bracket
		# that will not parse must not fall back to that: the per-model figure
		# would be published as the weekly total. The window is dropped and
		# the two that read cleanly are kept.
		name => 'label that cannot be read is not a missing label',
		screen => join("\r\n",
			'Current session',
			'23% 23% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week (all models)',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
			'Current week (Fable 5.1 (1M context))',
			'68% 68% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
		),
		session => 23,
		week => 31,
		model => undef,
		labels => '',
	},
	{
		# The panel prints figures that belong to no window of ours. Below the
		# windows sits a credits block with its own `100% 100% used` and a
		# reset of its own, so a heading drawn before its numbers must not
		# reach down to them: they parse cleanly and would be published as a
		# complete window at 100%.
		name => 'credits block below a heading drawn without numbers',
		screen => join("\r\n",
			'Current session',
			'5% 5% used',
			'Resets 9:10pm (Asia/Tokyo)',
			'Current week (all models)',
			'37% 37% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
			'+50% weekly limits promo through Sep 13',
			'Current week (Fable)',
			"What's contributing to your limits usage?",
			'Approximate, based on local sessions on this machine',
			'Scanning local sessions...',
			'Usage credits',
			'100% 100% used',
			'$0.00 / $0.00 spent - Resets Oct 1 (Asia/Tokyo)',
		),
		session => 5,
		week => 37,
		model => undef,
		labels => '',
	},
	{
		# The same reach, one window earlier: a partial redraw leaves numbers
		# with no heading of their own further down the capture.
		name => 'orphan numbers further down the capture',
		screen => join("\r\n",
			'Current session',
			'5% 5% used',
			'Resets 9:10pm (Asia/Tokyo)',
			'Current week (all models)',
			'37% 37% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
			'+50% weekly limits promo through Sep 13',
			'Current week (Fable)',
			"What's contributing to your limits usage?",
			'Approximate, based on local sessions on this machine',
			'Scanning local sessions...',
			'Esc to cancel',
			'99% 99% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
		),
		session => 5,
		week => 37,
		model => undef,
		labels => '',
	},
	{
		# What the section boundaries are for. The per-model heading arrived
		# before its numbers and the panel then started over, so the next
		# figures on the screen belong to the redraw's session window. Read
		# without a boundary they land under the per-model window's name.
		name => 'half-drawn per-model window followed by a redraw',
		screen => join("\r\n",
			'Current session',
			'23% 23% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week (all models)',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
			'Current week (Fable)',
			$esc . 'Current session',
			'55% 55% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week (all models)',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
		),
		session => 55,
		week => 31,
		model => undef,
		labels => '',
	},
	{
		# Same boundary, first window on the screen: with none of its own
		# numbers the session must come back empty, and the helper falls back
		# to the last cache rather than publishing the week's figure as it.
		name => 'session heading with no numbers of its own',
		screen => join("\r\n",
			'Current session',
			'Current week (all models)',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
		),
		session => undef,
		week => 31,
		model => undef,
		labels => '',
	},
	{
		name => 'half-drawn per-model window leaves the other two alone',
		screen => join("\r\n",
			'Current session',
			'23% 23% used',
			'Resets 11:10am (Asia/Tokyo)',
			'Current week (all models)',
			'31% 31% used',
			'Resets Sep 7, 9am (Asia/Tokyo)',
			'Current week (Fable)',
		),
		session => 23,
		week => 31,
		model => undef,
		labels => '',
	},
);

sub percent_of {
	my ($window) = @_;
	return undef unless $window;
	return $window->{reading}[0];
}

my $failures = 0;
for my $case (@cases) {
	my $windows = eval { read_windows(normalize_screen($case->{screen})) };
	if ($@) {
		printf "not ok - %s: died: %s", $case->{name}, $@;
		$failures++;
		next;
	}

	my @problems;
	for my $field (qw(session week model)) {
		my $key = $field eq 'model' ? 'model_week' : $field;
		my $got = percent_of($windows->{$key});
		my $want = $case->{$field};
		next if !defined $got && !defined $want;
		next if defined $got && defined $want && $got == $want;
		push @problems, sprintf '%s=%s expected=%s',
			$field,
			defined $got ? $got : 'undef',
			defined $want ? $want : 'undef';
	}

	my $got_label = $windows->{model_week} ? $windows->{model_week}{label} : undef;
	my $want_label = $case->{model_label};
	unless ((!defined $got_label && !defined $want_label)
		|| (defined $got_label && defined $want_label && $got_label eq $want_label)) {
		push @problems, sprintf 'label=%s expected=%s',
			defined $got_label ? $got_label : 'undef',
			defined $want_label ? $want_label : 'undef';
	}

	my $got_labels = join ', ', @{ $windows->{model_labels} };
	push @problems, sprintf 'labels=[%s] expected=[%s]', $got_labels, $case->{labels}
		if $got_labels ne $case->{labels};

	$failures++ if @problems;
	printf "%s - %s\n", @problems ? 'not ok' : 'ok', $case->{name};
	printf "    %s\n", join '; ', @problems if @problems;
}

printf "\n%d of %d cases failed\n", $failures, scalar @cases if $failures;
printf "\nall %d cases pass\n", scalar @cases unless $failures;
exit($failures ? 1 : 0);
