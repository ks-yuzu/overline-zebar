#!/usr/bin/env bash

# Behavior tests for the Codex launcher's node lookup. `bash -n` only proves the
# file parses, and this is the mechanism a path-resolution incident turned on:
# the hop limit, relative targets, and stopping before the chain's end each fix
# a case that took the cron refresh down or would have.

set -euo pipefail

here="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"
script="$here/codex-usage-json"

# The script is a linear program, not a library, so the function under test is
# lifted out of its source rather than sourced. A rename breaks this loudly.
definition="$(awk '/^find_node_dir\(\) \{$/,/^\}$/' "$script")"
if [[ -z "$definition" ]]; then
	printf 'find_node_dir is no longer defined as expected in %s\n' "$script" >&2
	exit 1
fi
eval "$definition"

work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT

failures=0
check() {
	local name="$1" expected="$2" actual="$3"
	if [[ "$expected" == "$actual" ]]; then
		printf 'ok   %s\n' "$name"
	else
		printf 'FAIL %s\n       expected: [%s]\n       actual:   [%s]\n' \
			"$name" "$expected" "$actual" >&2
		failures=$((failures + 1))
	fi
}

# Two of the cases below run forever if the hop cap goes away, and a test that
# never returns reports nothing. A timeout has to be distinguishable from an
# empty result, because empty is what those two cases expect.
export -f find_node_dir
bounded() {
	local out status=0
	out="$(timeout 5 bash -c 'find_node_dir "$1"' _ "$1")" || status=$?
	if ((status == 124)); then
		printf 'did not terminate'
		return 0
	fi
	printf '%s' "$out"
}

node_in() {
	mkdir -p -- "$1"
	printf '#!/bin/sh\n' >"$1/node"
	chmod +x -- "$1/node"
}

launcher_at() {
	mkdir -p -- "${1%/*}"
	printf '#!/usr/bin/env node\n' >"$1"
	chmod +x -- "$1"
}

# npm's own layout: the launcher links into the package, node sits beside the
# link. Returning the bin directory rather than the package is the whole point -
# `realpath` would land in lib/node_modules, where there is no node.
node_in "$work/npm/bin"
launcher_at "$work/npm/lib/node_modules/pkg/bin/codex.js"
ln -s ../lib/node_modules/pkg/bin/codex.js "$work/npm/bin/codex"
check 'npm layout stops at the sibling node' \
	"$work/npm/bin" "$(find_node_dir "$work/npm/bin/codex")"

# The incident: an extra hop through a directory that holds no node.
mkdir -p -- "$work/local"
ln -s "$work/npm/bin/codex" "$work/local/codex"
check 'a hop through a node-less directory keeps walking' \
	"$work/npm/bin" "$(find_node_dir "$work/local/codex")"

# A relative target resolves against the link's directory, not the caller's cwd.
mkdir -p -- "$work/rel/first"
node_in "$work/rel/second"
launcher_at "$work/rel/second/codex"
ln -s ../second/codex "$work/rel/first/codex"
check 'a relative target joins against the link directory' \
	"$work/rel/second" "$(cd / && find_node_dir "$work/rel/first/codex")"

# An executable that is not a symlink is still checked for a sibling node, which
# is how CODEX_USAGE_CODEX_BIN pointing straight at a version manager works.
node_in "$work/plain"
launcher_at "$work/plain/codex"
check 'a plain launcher finds its own sibling' \
	"$work/plain" "$(find_node_dir "$work/plain/codex")"

# The chain starts where PATH found the launcher, and the setup notes recommend
# that be /usr/local/bin, which commonly holds an unrelated node. The owner is
# the one paired with the launcher at the end of the chain, not the first found.
node_in "$work/head/bin"
ln -s "$work/npm/bin/codex" "$work/head/bin/codex"
check 'a node at the head of the chain loses to the owner' \
	"$work/npm/bin" "$(find_node_dir "$work/head/bin/codex")"

# A directory is executable too, so `-x` alone would stop the walk on one named
# `node` and never reach the real one.
mkdir -p -- "$work/dirnode/node"
launcher_at "$work/dirnode/codex"
check 'a directory named node is not a node' \
	'' "$(find_node_dir "$work/dirnode/codex")"

# No node anywhere is not an error. A native Codex needs none, so the caller
# launches it unchanged - and an empty result must not trip `set -e`.
launcher_at "$work/native/codex"
check 'a launcher with no node nearby yields nothing' \
	'' "$(find_node_dir "$work/native/codex")"

# A cycle has to terminate. Without the hop cap this runs until cron's timeout.
mkdir -p -- "$work/cycle"
ln -s "$work/cycle/b" "$work/cycle/a"
ln -s "$work/cycle/a" "$work/cycle/b"
check 'a symlink cycle terminates' '' "$(bounded "$work/cycle/a")"

# A chain longer than the cap gives up rather than following it to the end. node
# sits past the cap, so finding it would mean the limit is not being applied.
node_in "$work/deep/end"
launcher_at "$work/deep/end/codex"
previous="$work/deep/end/codex"
for hop in $(seq 1 12); do
	mkdir -p -- "$work/deep/h$hop"
	ln -s "$previous" "$work/deep/h$hop/codex"
	previous="$work/deep/h$hop/codex"
done
check 'a chain past the hop limit gives up' '' "$(bounded "$previous")"

if ((failures > 0)); then
	printf '\n%d test(s) failed\n' "$failures" >&2
	exit 1
fi
printf '\nall tests passed\n'
