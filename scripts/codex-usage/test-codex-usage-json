#!/usr/bin/env python3

"""Runs the Codex usage helper against a stand-in app-server.

The helper had no test before this one. It is driven end to end through
`CODEX_USAGE_CODEX_BIN`, because the parts worth pinning - what reaches the
archive, in what order, with which mode - are only observable from outside.
"""

import json
import os
import re
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

HERE = Path(__file__).resolve().parent
SCRIPT = HERE / "codex-usage-json"

RETAINED_RE = re.compile(r"\d{9}-\d{8}T\d{6}\.\d{6}Z\.json")

STUB = """#!/usr/bin/env python3
import json, os, sys

REPLY = os.environ["CODEX_STUB_REPLY"]
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    message = json.loads(line)
    if message.get("method") == "initialize":
        print(json.dumps({"id": message["id"], "result": {}}), flush=True)
    elif message.get("method") == "account/rateLimits/read":
        # Printed as given, so the test can tell the archive holds the reply
        # rather than anything the helper rebuilt.
        print(REPLY, flush=True)
        break
"""


def reply(request_id=2, primary=24, secondary=45):
    return json.dumps({
        "id": request_id,
        "result": {
            "rateLimits": {
                "limitId": "codex",
                "limitName": None,
                "primary": {"usedPercent": primary, "windowDurationMins": 300,
                            "resetsAt": 1789368000},
                "secondary": {"usedPercent": secondary, "windowDurationMins": 10080,
                              "resetsAt": 1789800000},
                "credits": None,
                "individualLimit": None,
                "spendControlReached": False,
                "planType": "team",
                "rateLimitReachedType": None,
            }
        },
    }, separators=(",", ":"))


class ArchiveTests(unittest.TestCase):
    def run_helper(self, cache_dir, stub, body, keep=None):
        env = os.environ.copy() | {
            "CODEX_USAGE_CACHE_DIR": str(cache_dir),
            "CODEX_USAGE_CODEX_BIN": str(stub),
            "CODEX_STUB_REPLY": body,
        }
        if keep is not None:
            env["CODEX_USAGE_API_RESPONSE_KEEP"] = str(keep)
        return subprocess.run([SCRIPT, "--force"], env=env, text=True,
                              capture_output=True)

    def prepare(self, root):
        stub = root / "codex"
        stub.write_text(STUB)
        stub.chmod(0o755)
        return stub

    def retained(self, cache_dir):
        directory = cache_dir / "api-responses"
        # Regular files only, as the helper counts them: something else
        # wearing the name is not a response.
        return sorted(path for path in directory.iterdir()
                      if path.is_file() and RETAINED_RE.fullmatch(path.name))

    def test_the_reply_is_kept_verbatim_and_the_oldest_is_dropped(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            stub = self.prepare(root)
            cache_dir = root / "cache"
            bodies = [reply(secondary=percent) for percent in (38, 11, 38)]
            for body in bodies:
                result = self.run_helper(cache_dir, stub, body, keep=2)
                self.assertEqual(result.returncode, 0, result.stderr)

            kept = self.retained(cache_dir)
            # The two most recent, in the order they were written, as sent.
            self.assertEqual([path.read_text().strip() for path in kept],
                             bodies[1:])
            self.assertTrue(all(path.stat().st_mode & 0o777 == 0o600
                                for path in kept))
            self.assertEqual((cache_dir / "api-responses").stat().st_mode & 0o777,
                             0o700)

    def test_the_sequence_advances_so_the_order_is_the_order_written(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            stub = self.prepare(root)
            cache_dir = root / "cache"
            for _ in range(3):
                self.run_helper(cache_dir, stub, reply(), keep=5)

            names = [path.name for path in self.retained(cache_dir)]
            self.assertEqual([name.split("-")[0] for name in names],
                             ["000000001", "000000002", "000000003"])

    def test_nothing_is_dropped_while_the_directory_is_still_filling(self):
        # The limit is a fortnight of runs, so for a fortnight there are fewer
        # files than it. Counting the excess against a limit not yet reached
        # has to take nothing.
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            stub = self.prepare(root)
            cache_dir = root / "cache"
            for index in range(4):
                self.run_helper(cache_dir, stub, reply(primary=index), keep=5)

            self.assertEqual(len(self.retained(cache_dir)), 4)

    def test_an_entry_that_is_not_a_file_is_left_alone_and_not_counted(self):
        # Only regular files are candidates. Something else wearing the name -
        # a directory left by hand - must neither be removed nor counted, or
        # the run would try to unlink it on every pass and the limit would be
        # measured against something that is not a response.
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            stub = self.prepare(root)
            cache_dir = root / "cache"
            for _ in range(3):
                self.run_helper(cache_dir, stub, reply(), keep=3)

            stray = self.retained(cache_dir)[1]
            stray.unlink()
            stray.mkdir()

            for _ in range(4):
                result = self.run_helper(cache_dir, stub, reply(), keep=3)
                self.assertEqual(result.returncode, 0, result.stderr)

            self.assertTrue(stray.is_dir())
            self.assertEqual(len(self.retained(cache_dir)), 3)

    def test_the_sequence_passes_the_digits_octal_would_refuse(self):
        # The name is zero-padded, so arithmetic on it reads as octal unless it
        # is forced to base ten - and 8 is where octal stops being able to. The
        # eighth run is forty minutes in, not an edge.
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            stub = self.prepare(root)
            cache_dir = root / "cache"
            seeded = cache_dir / "api-responses"
            seeded.mkdir(parents=True)
            (seeded / "000000008-20260101T000000.000000Z.json").write_text("{}\n")

            result = self.run_helper(cache_dir, stub, reply(), keep=5)
            self.assertEqual(result.returncode, 0, result.stderr)

            names = [path.name for path in self.retained(cache_dir)]
            self.assertEqual([name.split("-")[0] for name in names],
                             ["000000008", "000000009"])

    def test_a_name_outside_the_pattern_does_not_stop_the_run(self):
        # The sequence is read off the newest name, so a `.json` that is not
        # one of ours would be fed to arithmetic and abort the whole run under
        # `set -e` - taking the reading with it, not just the archive.
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            stub = self.prepare(root)
            cache_dir = root / "cache"
            seeded = cache_dir / "api-responses"
            seeded.mkdir(parents=True)
            (seeded / "notes.json").write_text("{}\n")

            result = self.run_helper(cache_dir, stub, reply(), keep=5)

            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(len(self.retained(cache_dir)), 1)
            self.assertTrue((seeded / "notes.json").exists())

    def test_a_rejected_keep_stops_the_run_before_it_fetches(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            stub = self.prepare(root)
            cache_dir = root / "cache"
            result = self.run_helper(cache_dir, stub, reply(), keep="0")
            self.assertEqual(result.returncode, 64)
            self.assertIn("CODEX_USAGE_API_RESPONSE_KEEP", result.stderr)


if __name__ == "__main__":
    unittest.main(verbosity=1)
