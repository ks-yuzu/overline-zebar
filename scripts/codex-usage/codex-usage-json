#!/usr/bin/env bash

set -euo pipefail

timeout_seconds="${CODEX_USAGE_TIMEOUT:-15}"
if [[ ! "$timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
	printf 'CODEX_USAGE_TIMEOUT must be a positive integer\n' >&2
	exit 64
fi

cache_ttl_seconds="${CODEX_USAGE_CACHE_TTL:-300}"
if [[ ! "$cache_ttl_seconds" =~ ^[1-9][0-9]*$ ]]; then
	printf 'CODEX_USAGE_CACHE_TTL must be a positive integer\n' >&2
	exit 64
fi

# A fortnight of five-minute runs: the same span the samples keep, so a
# response is still there when its sample is questioned.
api_response_keep="${CODEX_USAGE_API_RESPONSE_KEEP:-4032}"
if [[ ! "$api_response_keep" =~ ^[1-9][0-9]*$ ]]; then
	printf 'CODEX_USAGE_API_RESPONSE_KEEP must be a positive integer\n' >&2
	exit 64
fi

force_refresh=false
cached_only=false
case "${1:-}" in
	'') ;;
	--force) force_refresh=true ;;
	--cached-only) cached_only=true ;;
	*)
		printf 'usage: %s [--force|--cached-only]\n' "$0" >&2
		exit 64
		;;
esac

cache_dir="${CODEX_USAGE_CACHE_DIR:-$HOME/.cache/codex-usage-json}"
cache_file="$cache_dir/usage.json"
# Append-only archive of raw samples. The cache prunes to 14 days on every
# write, so without this the older history is gone for good and no later
# rollup can be computed for it. The widget never reads this file.
samples_file="$cache_dir/samples.ndjson"
# Raw app-server replies, kept so that a reading questioned days later can be
# traced back to what was actually said. The widget never reads these either.
responses_dir="$cache_dir/api-responses"
lock_file="$cache_dir/update.lock"
mkdir -p -- "$cache_dir"
chmod 700 -- "$cache_dir"

if [[ "$cached_only" == true ]]; then
	if [[ ! -s "$cache_file" ]]; then
		printf 'Codex usage cache is not available yet\n' >&2
		exit 66
	fi
	cat -- "$cache_file"
	exit 0
fi

cache_is_fresh() {
	[[ -s "$cache_file" ]] || return 1
	local modified_at now
	modified_at="$(stat -c %Y -- "$cache_file")" || return 1
	now="$(date +%s)"
	((now - modified_at < cache_ttl_seconds))
}

if [[ "$force_refresh" == false ]] && cache_is_fresh; then
	cat -- "$cache_file"
	exit 0
fi

for command_name in jq flock; do
	if ! command -v "$command_name" >/dev/null 2>&1; then
		printf 'required command not found: %s\n' "$command_name" >&2
		if [[ -s "$cache_file" ]]; then
			cat -- "$cache_file"
			exit 0
		fi
		exit 69
	fi
done

exec 9>"$lock_file"
flock 9

if [[ "$force_refresh" == false ]] && cache_is_fresh; then
	cat -- "$cache_file"
	exit 0
fi

codex_bin="${CODEX_USAGE_CODEX_BIN:-$(command -v codex || true)}"
if [[ -z "$codex_bin" || ! -x "$codex_bin" ]]; then
	printf 'Codex executable not usable: %s; set CODEX_USAGE_CODEX_BIN or put codex on PATH\n' \
		"${codex_bin:-not found on PATH}" >&2
	if [[ -s "$cache_file" ]]; then
		cat -- "$cache_file"
		exit 0
	fi
	exit 69
fi

archive_sample() {
	# Entries repeat a recorded_at when a run lands within 60s of the previous
	# one, the same case the cache collapses. Readers dedupe on recorded_at.
	# Create it before the redirect does, so a failing jq cannot leave the file
	# behind at the default umask with no later run willing to fix the mode.
	if [[ ! -e "$samples_file" ]]; then
		: >"$samples_file" || return 0
		chmod 600 -- "$samples_file"
	fi
	jq -c '.history[-1]' -- "$result_file" >>"$samples_file" 2>/dev/null || return 0
	return 0
}

record_api_response() {
	# A reading that turns out to be wrong is only visible days later, as a
	# shape in the fortnight chart. Keeping the reply it came from is what lets
	# the question be answered then; the rollup alone cannot say where a value
	# came from. Recorded verbatim apart from the newline `read` consumed,
	# because a reading can be wrong in which part of a reply it was taken from.
	local response="$1"
	local dir="$responses_dir"

	if ! mkdir -p -- "$dir" || ! chmod 700 -- "$dir"; then
		printf 'codex usage: cannot retain the API response\n' >&2
		return 0
	fi

	# The sequence leads the name so the archive orders by the order things
	# were written. A clock can step backwards - a host waking from sleep is
	# enough - and ordering by a clock reading would make every run during the
	# lag look like the oldest entry, so each would be dropped by the next.
	local -a existing=()
	local path base
	for path in "$dir"/*.json; do
		[[ -f "$path" ]] || continue
		base="${path##*/}"
		[[ "$base" =~ ^[0-9]{9}-[0-9]{8}T[0-9]{6}\.[0-9]{6}Z\.json$ ]] || continue
		existing+=("$path")
	done

	local sequence=1
	if ((${#existing[@]} > 0)); then
		base="${existing[-1]##*/}"
		# Base 10 outright: nine digits with leading zeros would read as octal.
		sequence=$((10#${base%%-*} + 1))
	fi

	local stamp target tmp
	stamp="$(date -u +%Y%m%dT%H%M%S.%6NZ)"
	target="$(printf '%s/%09d-%s.json' "$dir" "$sequence" "$stamp")"
	if ! tmp="$(mktemp "$dir/.api-response.XXXXXX")"; then
		printf 'codex usage: cannot retain the API response\n' >&2
		return 0
	fi
	if ! printf '%s\n' "$response" >"$tmp" || ! chmod 600 -- "$tmp" ||
		! mv -f -- "$tmp" "$target"; then
		rm -f -- "$tmp"
		printf 'codex usage: cannot retain the API response\n' >&2
		return 0
	fi

	# `existing` is what was there before this run wrote, so the reply just
	# written is not among the candidates and needs no rule of its own.
	local drop=$((${#existing[@]} - api_response_keep + 1))
	local index
	for ((index = 0; index < drop; index++)); do
		# One entry that cannot go must not stop the ones that can. It is
		# always the oldest, so it is always first, and a pass that stopped
		# there would stop in the same place on every later run while the
		# directory grew past the only bound it has.
		rm -f -- "${existing[index]}" ||
			printf 'codex usage: cannot prune %s\n' "${existing[index]##*/}" >&2
	done
	return 0
}

result_file="$(mktemp "$cache_dir/usage.json.XXXXXX")"
error_file="$(mktemp "${TMPDIR:-/tmp}/codex-usage.XXXXXX")"
server_pid=''

cleanup() {
	if [[ -n "$server_pid" ]]; then
		kill "$server_pid" 2>/dev/null || true
		wait "$server_pid" 2>/dev/null || true
	fi
	rm -f -- "$result_file" "$error_file"
}
trap cleanup EXIT

response_line=''
server_out_fd=''
server_in_fd=''

read_response() {
	local expected_id="$1"
	local line remaining
	local deadline=$((SECONDS + timeout_seconds))

	while ((SECONDS < deadline)); do
		remaining=$((deadline - SECONDS))
		if ! IFS= read -r -t "$remaining" -u "$server_out_fd" line; then
			return 1
		fi
		if jq -e --argjson expected "$expected_id" '.id == $expected' \
			>/dev/null 2>&1 <<<"$line"; then
			response_line="$line"
			return 0
		fi
	done

	return 1
}

stop_server() {
	if [[ -n "$server_pid" ]]; then
		kill "$server_pid" 2>/dev/null || true
		wait "$server_pid" 2>/dev/null || true
		server_pid=''
	fi
}

refresh_usage() {
	local generated_epoch history_source
	coproc CODEX_USAGE_SERVER {
		"$codex_bin" app-server --stdio 2>"$error_file"
	}
	server_pid="$CODEX_USAGE_SERVER_PID"
	server_out_fd="${CODEX_USAGE_SERVER[0]}"
	server_in_fd="${CODEX_USAGE_SERVER[1]}"

	if ! printf '%s\n' \
		'{"method":"initialize","id":1,"params":{"clientInfo":{"name":"zebar-usage-monitor","title":"Zebar usage monitor","version":"1"}}}' \
		>&"$server_in_fd"; then
		return 1
	fi

	if ! read_response 1 || ! jq -e '.error == null' >/dev/null <<<"$response_line"; then
		return 1
	fi

	if ! printf '%s\n' '{"method":"initialized"}' >&"$server_in_fd"; then
		return 1
	fi
	# This account-level read does not call thread/start or turn/start, so the
	# monitor neither creates conversation history nor invokes a model.
	if ! printf '%s\n' \
		'{"method":"account/rateLimits/read","id":2}' \
		>&"$server_in_fd"; then
		return 1
	fi

	if ! read_response 2; then
		return 1
	fi

	record_api_response "$response_line"

	generated_epoch="$(date +%s)"
	history_source='/dev/null'
	if [[ -s "$cache_file" ]] && jq -e '
		type == "object" and ((.history // []) | type == "array")
	' >/dev/null 2>&1 "$cache_file"; then
		history_source="$cache_file"
	fi

	# -c: the widget re-reads this file every 60s, and indentation was nearly
	# half its size.
	if ! jq -ce \
		--arg generated_at "$(date --iso-8601=seconds)" \
		--argjson generated_epoch "$generated_epoch" \
		--slurpfile previous "$history_source" '
		def valid_window:
			type == "object" and
			(.usedPercent | type == "number") and
			(.windowDurationMins | type == "number") and
			(.resetsAt | type == "number");
		def valid_history_sample:
			type == "object" and
			(.recorded_at | type == "number") and
			(.windows | type == "array") and
			(.windows | all(.[]; valid_window));
		.result.rateLimits as $limits |
		select(
			($limits | type == "object") and
			($limits.primary == null or ($limits.primary | valid_window)) and
			($limits.secondary == null or ($limits.secondary | valid_window))
		) |
		([$limits.primary, $limits.secondary] |
			map(select(. != null) | {
				usedPercent,
				windowDurationMins,
				resetsAt
			})
		) as $windows |
		(($previous[0].history? // []) |
			map(select(
				valid_history_sample and
				.recorded_at >= ($generated_epoch - 14 * 24 * 60 * 60)
			)) |
			if length > 0 and
				($generated_epoch - .[-1].recorded_at < 60)
			then .[:-1] else . end
		) as $history |
		{
			source: "codex app-server account/rateLimits/read",
			generated_at: $generated_at,
			rate_limits: $limits,
			history: ($history + [{
				recorded_at: $generated_epoch,
				windows: $windows
			}])
		}
	' >"$result_file" <<<"$response_line"; then
		return 1
	fi

	archive_sample

	stop_server
	return 0
}

if ! refresh_usage; then
	stop_server
	printf 'failed to refresh Codex usage through %s; using cached data when available\n' \
		"$codex_bin" >&2
	if [[ -s "$error_file" ]]; then
		sed -n '1,5p' "$error_file" >&2
	fi
	if [[ -s "$cache_file" ]]; then
		cat -- "$cache_file"
		exit 0
	fi
	exit 70
fi

chmod 600 -- "$result_file"
mv -f -- "$result_file" "$cache_file"
cat -- "$cache_file"
