# Refresh the cache when the WSL distribution starts and every five minutes.
#
# cron loads no shell initialization, so its PATH is not an interactive shell's.
# `codex` has to be reachable from it - a symlink into /usr/local/bin is enough
# - or named by CODEX_USAGE_CODEX_BIN, which the helper takes over PATH. With
# neither it exits 69, serves the last cache it has, and says so in the journal.
@reboot     /usr/bin/timeout 30s "$HOME/bin/codex-usage-json" --force 2>&1 >/dev/null | /usr/bin/logger -t codex-usage.cron
*/5 * * * * /usr/bin/timeout 30s "$HOME/bin/codex-usage-json" --force 2>&1 >/dev/null | /usr/bin/logger -t codex-usage.cron

# @reboot     CODEX_USAGE_CODEX_BIN=/usr/local/bin/codex /usr/bin/timeout 30s "$HOME/bin/codex-usage-json" --force 2>&1 >/dev/null | /usr/bin/logger -t codex-usage.cron
# */5 * * * * CODEX_USAGE_CODEX_BIN=/usr/local/bin/codex /usr/bin/timeout 30s "$HOME/bin/codex-usage-json" --force 2>&1 >/dev/null | /usr/bin/logger -t codex-usage.cron
